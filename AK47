local function cancelInspect()
	if not inspecting then return false end
	token = token + 1
	local my = token
	local from, fromW = {}, {}
	for _, k in ipairs(SCALARS) do from[k] = rl[k] end
	for _, k in ipairs(HAND_KEYS) do fromW[k] = rl.w[k] end
	rl.magState = 0
	task.spawn(function()
		local t0 = tick()
		while token == my do
			local a = math.clamp((tick() - t0) / 0.25, 0, 1)
			local e = EASE.smooth(a)
			for _, k in ipairs(SCALARS) do rl[k] = from[k] * (1 - e) end
			for _, k in ipairs(HAND_KEYS) do
				local to = (k == cur.idleHand) and 1 or 0
				rl.w[k] = fromW[k] + (to - fromW[k]) * e
			end
			if a >= 1 then break end
			RunService.RenderStepped:Wait()
		end
		if token == my then
			resetRL(cur)
			inspecting = false
		end
	end)
	return true
end

reload = function()
	if cancelInspect() then return end
	local rig = cur
	if reloading or swPending or rig.ammo >= rig.magSize then return end
	reloading, aiming = true, false
	token = token + 1
	local my = token
	refreshHUD()

	task.spawn(function()
		local function phase(dur, tgt, easing)
			local from = {}
			for _, k in ipairs(SCALARS) do from[k] = rl[k] end
			local fromW = {}
			for _, k in ipairs(HAND_KEYS) do fromW[k] = rl.w[k] end
			local ef = EASE[easing or "smooth"]
			local t0 = tick()
			while true do
				if token ~= my then return false end
				local a = math.clamp((tick() - t0) / dur, 0, 1)
				local e = ef(a)
				for _, k in ipairs(SCALARS) do
					if tgt[k] ~= nil then rl[k] = from[k] + (tgt[k] - from[k]) * e end
				end
				if tgt.hand then
					for _, k in ipairs(HAND_KEYS) do
						local to = (k == tgt.hand) and 1 or 0
						rl.w[k] = fromW[k] + (to - fromW[k]) * e
					end
				end
				if a >= 1 then return true end
				RunService.RenderStepped:Wait()
			end
		end

		if not rig.reloadSeq(phase) then return end

		resetRL(rig)
		rig.ammo = rig.magSize
		reloading = false
		clicked = false
		refreshHUD()
	end)
end

local function inspect()
	if cancelInspect() then return end
	local rig = cur
	if reloading or swPending or swA > 0.05 or not rig.inspectSeq then return end
	inspecting, aiming = true, false
	token = token + 1
	local my = token
	task.spawn(function()
		local function phase(dur, tgt, easing)
			local from = {}
			for _, k in ipairs(SCALARS) do from[k] = rl[k] end
			local fromW = {}
			for _, k in ipairs(HAND_KEYS) do fromW[k] = rl.w[k] end
			local ef = EASE[easing or "smooth"]
			local t0 = tick()
			while true do
				if token ~= my then return false end
				local a = math.clamp((tick() - t0) / dur, 0, 1)
				local e = ef(a)
				for _, k in ipairs(SCALARS) do
					if tgt[k] ~= nil then rl[k] = from[k] + (tgt[k] - from[k]) * e end
				end
				if tgt.hand then
					for _, k in ipairs(HAND_KEYS) do
						local to = (k == tgt.hand) and 1 or 0
						rl.w[k] = fromW[k] + (to - fromW[k]) * e
					end
				end
				if a >= 1 then return true end
				RunService.RenderStepped:Wait()
			end
		end

		if not rig.inspectSeq(phase) then return end

		resetRL(rig)
		inspecting = false
	end)
end

local function toggleMode()
	local rig = cur
	rig.mode = rig.mode % #rig.modes + 1
	play("Click")
	refreshHUD()
end

local function switchTo(r)
	if not r or r == cur or swPending then return end
	swPending = r
	aiming = false
end

local function doSwap(r)
	token = token + 1
	reloading, clicked = false, false
	inspecting = false
	cur.model.Parent = nil
	resetRL(cur)
	cur = r
	resetRL(cur)
	applyLock(cur)
	cur.model.Parent = model
	handBlend = (lastHandCam and lastRCam) and 1 or 0
	fromHandCam, fromRCam = lastHandCam, lastRCam
	refreshHUD()
	play("Click", 0.5)
end

local function nextWeapon()
	switchTo(cur == RIGS.AK47 and RIGS.PISTOL or RIGS.AK47)
end

local conns = {}
local function on(sig, fn) table.insert(conns, sig:Connect(fn)) end

local function press()
	held = true
	clicked = false
	if cancelInspect() then return end
	if cur.modes[cur.mode] ~= "AUTO" then fire() end
end
local function release() held = false end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end

on(bFire.InputBegan, function(i) if isPress(i) then press() end end)
on(bFire.InputEnded, function(i) if isPress(i) then release() end end)
on(bAim.InputBegan, function(i) if isPress(i) and not cancelInspect() then aiming = not aiming end end)
on(bRel.InputBegan, function(i) if isPress(i) then reload() end end)
on(bMode.InputBegan, function(i) if isPress(i) then toggleMode() end end)
on(bCrouch.InputBegan, function(i) if isPress(i) then setCrouch(not crouching) end end)
on(bSwap.InputBegan, function(i) if isPress(i) then nextWeapon() end end)
on(bInsp.InputBegan, function(i) if isPress(i) then inspect() end end)
on(bPeekL.InputBegan, function(i) if isPress(i) then setPeek(-1) end end)
on(bPeekL.InputEnded, function(i) if isPress(i) and peekDir == -1 then setPeek(0) end end)
on(bPeekR.InputBegan, function(i) if isPress(i) then setPeek(1) end end)
on(bPeekR.InputEnded, function(i) if isPress(i) and peekDir == 1 then setPeek(0) end end)

on(UIS.InputBegan, function(i, gp)
	if gp then return end
	if i.UserInputType == Enum.UserInputType.MouseButton1 then press()
	elseif i.UserInputType == Enum.UserInputType.MouseButton2 then aiming = not cancelInspect()
	elseif i.KeyCode == Enum.KeyCode.R then reload()
	elseif i.KeyCode == Enum.KeyCode.B then toggleMode()
	elseif i.KeyCode == Enum.KeyCode.C then setCrouch(not crouching)
	elseif i.KeyCode == Enum.KeyCode.V then nextWeapon()
	elseif i.KeyCode == Enum.KeyCode.One then switchTo(RIGS.AK47)
	elseif i.KeyCode == Enum.KeyCode.Two then switchTo(RIGS.PISTOL)
	elseif i.KeyCode == Enum.KeyCode.F then inspect()
	elseif i.KeyCode == Enum.KeyCode.Q then setPeek(-1)
	elseif i.KeyCode == Enum.KeyCode.E then setPeek(1) end
end)
on(UIS.InputEnded, function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then release()
	elseif i.UserInputType == Enum.UserInputType.MouseButton2 then aiming = false
	elseif i.KeyCode == Enum.KeyCode.Q and peekDir == -1 then setPeek(0)
	elseif i.KeyCode == Enum.KeyCode.E and peekDir == 1 then setPeek(0) end
end)

local REL_CAM  = Vector3.new(-0.55, -0.50, -1.1)
local SHOW_CAM = Vector3.new(-0.42, -0.10, -1.05)
local POUCH    = Vector3.new(-0.95, -0.85, -1.0)
local IDLE_CAM = Vector3.new(-1.3, -1.7, -0.8)

local HAND_SIZE  = Vector3.new(0.4, 0.34, 0.44)
local ARM_BONE   = 1.55
local SHOULDER_R = Vector3.new(1.25, -1.7, 0.9)
local SHOULDER_L = Vector3.new(-1.25, -1.7, 0.9)
local POLE_R     = Vector3.new(0.9, -1, 0.1)
local POLE_L     = Vector3.new(-0.9, -1, 0.1)
local DARK       = Color3.new(0, 0, 0)

local hiddenList, hiddenT = {}, 0
local t0 = tick()

local function bone(p, a, b, thick)
	local d = (b - a).Magnitude
	p.Size = Vector3.new(thick, thick, math.max(d, 0.01))
	p.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -d / 2)
end

local function placeArm(A, shoulder, to, pole, color, visible, handScale)
	local d = to - shoulder
	local dist = math.max(d.Magnitude, 0.01)
	local dir = d / dist
	local pv = pole - dir * pole:Dot(dir)
	pv = (pv.Magnitude > 1e-3) and pv.Unit or Vector3.yAxis
	local h = (dist < 2 * ARM_BONE) and math.sqrt(ARM_BONE * ARM_BONE - dist * dist / 4) or 0
	local elbow = shoulder + dir * (dist / 2) + pv * h

	local sleeve, skin = color:Lerp(DARK, 0.22), color:Lerp(DARK, 0.08)
	A.up.Color, A.elbow.Color, A.fore.Color, A.hand.Color = sleeve, sleeve, skin, color
	local tr = visible and 0 or 1
	A.up.Transparency, A.elbow.Transparency, A.fore.Transparency, A.hand.Transparency = tr, tr, tr, tr

	bone(A.up, shoulder, elbow, 0.40)
	bone(A.fore, elbow, to, 0.34)
	A.elbow.Size = Vector3.new(0.42, 0.42, 0.42)
	A.elbow.CFrame = CFrame.new(elbow)
	A.hand.Size = HAND_SIZE * handScale
	A.hand.CFrame = CFrame.lookAt(to, elbow)
end

local function leftHandPos(rig, gripCF, camCF)
	local w, P, S = rl.w, rig.pts, rig.S
	local tot = 0
	for _, k in ipairs(HAND_KEYS) do tot = tot + w[k] end
	if tot < 1e-4 then w, tot = {[rig.idleHand] = 1}, 1 end
	local function g(k) return w[k] or 0 end
	local p = gripCF:PointToWorldSpace(P.L_HG * S) * g("HG")
		+ gripCF:PointToWorldSpace(P.L_MW * S) * g("MW")
		+ camCF:PointToWorldSpace(P.OUT_CAM) * g("OUT")
		+ camCF:PointToWorldSpace(POUCH) * g("PCH")
		+ gripCF:PointToWorldSpace(P.L_INS * S) * g("INS")
		+ gripCF:PointToWorldSpace((P.L_BLT + Vector3.new(0, 0, rl.boltZ)) * S) * g("BLT")
		+ camCF:PointToWorldSpace(REL_CAM) * g("REL")
		+ camCF:PointToWorldSpace(SHOW_CAM) * g("SHW")
		+ camCF:PointToWorldSpace(IDLE_CAM) * g("IDLE")
	return p / tot
end

local function update(dt)
	local ch = LP.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		model.Parent = nil
		swP, swY = 0, 0
		return
	end
	model.Parent = cam

	do
		local c = cam.CFrame
		local look = c.LookVector
		if math.abs(look.Y) < 0.995 then
			local lvl = CFrame.lookAt(c.Position, c.Position + look)
			cam.CFrame = CFrame.new(c.Position) * CFrame.Angles(0, -swY, 0) * rotOnly(lvl) * CFrame.Angles(-swP, 0, 0)
		end
		swP, swY = 0, 0
	end

	if crouchHum ~= hum then
		crouchHum, crouching, crouchA, crouchSpeed0, crouchDirty = hum, false, 0, nil, false
		btnActive(bCrouch, false)
		peekA = 0
		setPeek(0)
	end
	crouchA = crouchA + ((crouching and 1 or 0) - crouchA) * math.min(1, dt * 10)
	peekA = peekA + (peekDir - peekA) * math.min(1, dt * 10)
	if crouching or crouchA > 0.002 or math.abs(peekA) > 0.002 or BC then
		hum.CameraOffset = Vector3.new(peekA * PEEK_DIST, -CROUCH_DEPTH * crouchA - (BC and BC_DROP or 0), 0)
		crouchDirty = true
	elseif crouchDirty then
		hum.CameraOffset = Vector3.new(0, 0, 0)
		crouchDirty = false
	end
	if math.abs(peekA) > 0.002 then
		cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, -peekA * PEEK_ROLL)
	end

	if tick() - hiddenT > 0.5 then
		hiddenT = tick()
		hiddenList = {}
		for _, d in ipairs(ch:GetDescendants()) do
			if d:IsA("BasePart") then table.insert(hiddenList, d) end
		end
	end
	for _, p in ipairs(hiddenList) do p.LocalTransparencyModifier = 1 end

	for _, s in pairs(sp) do stepSpring(s, dt) end

	if swPending then
		swA = math.min(1, swA + dt / 0.16)
		if swA >= 1 then
			doSwap(swPending)
			swPending = nil
		end
	elseif swA > 0 then
		swA = math.max(0, swA - dt / 0.2)
	end

	local rig = cur
	local S = rig.S
	local aimGoal = (aiming and not reloading and not inspecting and not swPending and swA < 0.05) and 1 or 0
	aimA = aimA + (aimGoal - aimA) * math.min(1, dt * 14)

	if held and rig.modes[rig.mode] == "AUTO" then fire() end

	local speed = hum.MoveDirection.Magnitude > 0 and (hum.RootPart and hum.RootPart.AssemblyLinearVelocity.Magnitude or 0) or 0
	local kRaw = math.clamp(speed / 16, 0, 1)
	local k = kRaw * (1 - aimA * 0.8)
	local t = tick() - t0
	local bob = rig.sway(t, kRaw, aimA, speed)

	local base = rig.HIP:Lerp(rig.ADS, aimA)
	local swCF = CFrame.new(0.25 * swA, -1.0 * swA, 0.2 * swA) * CFrame.Angles(-0.8 * swA, 0, 0.25 * swA)
	local rel = rig.relPose(rl.tilt, rl.rack)
	local rec = CFrame.new(0, 0, sp.rz[1]) * CFrame.Angles(sp.rp[1], 0, 0)
	local camCF = cam.CFrame
	local gl, gy, gr = rl.gunLift, rl.gunYaw, rl.gunRoll
	local flour = CFrame.new()
	if rig.flourish then
		flour = rig.flourish(gl, gy, gr, rl.gunSpin)
	elseif gl > 0.001 or gr ~= 0 then
		local mid = Vector3.new(0, 0.25, -1.6) * S
		flour = CFrame.new(-0.55 * gl, 0.30 * gl, 0.90 * gl) * CFrame.new(mid)
			* CFrame.Angles(0, gy, 0) * CFrame.Angles(0, 0, gr) * CFrame.new(-mid)
	end
	local insp = CFrame.new()
	if rl.iLift > 0.001 or rl.iPitch ~= 0 or rl.iYaw ~= 0 or rl.iRoll ~= 0 then
		local pv = rig.iPivot * S
		insp = CFrame.new(rig.iOff * rl.iLift) * CFrame.new(pv) * CFrame.Angles(rl.iPitch, rl.iYaw, rl.iRoll) * CFrame.new(-pv)
	end
	local gripCF = camCF * swCF * base * bob * rec * rel * flour * insp

	for i, p in ipairs(rig.parts) do
		p.CFrame = gripCF * rig.LOCAL[i]
	end
	for _, i in ipairs(rig.slideIdx) do
		rig.parts[i].CFrame = gripCF * CFrame.new(0, 0, (sp.bolt[1] * rig.slideK + rl.boltZ) * S) * rig.LOCAL[i]
	end

	local handPos = leftHandPos(rig, gripCF, camCF)
	local rHandPos = gripCF:PointToWorldSpace((rig.pts.R_HAND + (rig.pts.R_REL or Vector3.new()) * rl.rhi) * S)
	if rig.twirlPivot and rl.twirl > 0.001 then
		rHandPos = rHandPos:Lerp(gripCF:PointToWorldSpace(rig.twirlPivot * S), rl.twirl)
	end
	if handBlend > 0 then
		handBlend = math.max(0, handBlend - dt / 0.22)
		local e = handBlend * handBlend
		if fromHandCam then handPos = handPos:Lerp(camCF:PointToWorldSpace(fromHandCam), e) end
		if fromRCam then rHandPos = rHandPos:Lerp(camCF:PointToWorldSpace(fromRCam), e) end
	end
	lastHandCam = camCF:PointToObjectSpace(handPos)
	lastRCam = camCF:PointToObjectSpace(rHandPos)

	local mag = rig.mag
	if mag then
		local mc
		if rl.magState == 0 then
			mc = gripCF * rig.LOCAL[rig.magI]
		elseif rl.magState == 1 then
			local up = camCF:VectorToWorldSpace(Vector3.new(0, rl.toss, 0))
			local orient = rotOnly(gripCF):Lerp(rotOnly(camCF), rl.free)
			mc = CFrame.new(handPos + up) * orient * CFrame.Angles(rl.rock, 0, 0) * CFrame.new(0, rig.pts.MAG_HOLD * S, 0)
				* CFrame.Angles(rl.flip, rl.twist, 0) * rig.MAGROT
		end
		if mc then
			mag.Transparency = 0
			mag.CFrame = mc
			lastMagCF = mc
		else
			mag.Transparency = 1
		end
	end

	local col = armColor()
	placeArm(ARMS.R, camCF * SHOULDER_R, rHandPos, camCF:VectorToWorldSpace(POLE_R), col, true, 1 - 0.45 * rl.twirl)
	placeArm(ARMS.L, camCF * SHOULDER_L, handPos, camCF:VectorToWorldSpace(POLE_L), col, rl.w.IDLE < 0.98, 1)

	local fovAim = rig.aimFovMul and (FOV_HIP * rig.aimFovMul) or FOV_AIM
	cam.FieldOfView = FOV_HIP + (fovAim - FOV_HIP) * aimA
	if BC then
		local tt = tick()
		local calm = 1 - aimA * 0.6
		local pitch = (math.noise(tt * 1.1, 0.3) * 0.006 + math.sin(tt * 9) * 0.006 * k) * calm
		local yaw   = (math.noise(tt * 1.4, 5.1) * 0.006 + math.noise(tt * 6, 2.2) * 0.012 * k) * calm
		local roll  = (math.noise(tt * 0.9, 9.2) * 0.012 + math.sin(tt * 4.5) * 0.014 * k) * calm
		swP, swY = pitch, yaw
		local c = cam.CFrame
		cam.CFrame = CFrame.new(c.Position) * CFrame.Angles(0, yaw, 0) * rotOnly(c) * CFrame.Angles(pitch, 0, 0) * CFrame.Angles(0, 0, roll)
	end
	cam.CFrame = cam.CFrame * CFrame.Angles(sp.cam[1] * 0.12, 0, 0)
	dot.Visible = aimA < 0.5
end

local STEP = "AK47_Viewmodel"
RunService:BindToRenderStep(STEP, Enum.RenderPriority.Camera.Value + 1, update)

pcall(function() LP.CameraMode = Enum.CameraMode.LockFirstPerson end)

genv.AK47_Cleanup = function()
	pcall(function() if notifyConn then notifyConn:Disconnect() end end)
	pcall(function() if notifyGui then notifyGui:Destroy() end end)
	pcall(function() if bodycamFX then bodycamFX:Destroy() end end)
	token = token + 1
	pcall(function()
		if crouchHum then
			crouchHum.CameraOffset = Vector3.new(0, 0, 0)
			if crouchSpeed0 then crouchHum.WalkSpeed = crouchSpeed0 end
		end
	end)
	pcall(function() RunService:UnbindFromRenderStep(STEP) end)
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	pcall(function() model:Destroy() end)
	for _, r in pairs(RIGS) do pcall(function() r.model:Destroy() end) end
	pcall(function() gui:Destroy() end)
	pcall(function() fxFolder:Destroy() end)
	pcall(function() LP.CameraMode = Enum.CameraMode.Classic end)
	pcall(function() cam.FieldOfView = 70 end)
	for _, p in ipairs(hiddenList) do pcall(function() p.LocalTransparencyModifier = 0 end) end
	for _, h in ipairs(goreHidden) do pcall(function() h[1][h[2]] = h[3] end) end
end

