	ilab.Text = "S"
	ilab.TextColor3 = Color3.fromRGB(238, 241, 248)
	ilab.Parent = icon

	local DIM, LIGHT = Color3.fromRGB(118, 121, 130), Color3.fromRGB(255, 255, 255)
	local function letters(parent, text, size)
		local list = Instance.new("UIListLayout")
		list.FillDirection = Enum.FillDirection.Horizontal
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Parent = parent
		local out = {}
		for i = 1, #text do
			local ch = text:sub(i, i)
			local w = Instance.new("Frame")
			w.BackgroundTransparency = 1
			w.LayoutOrder = i
			w.Parent = parent
			if ch == " " then
				w.Size = UDim2.fromOffset(math.floor(size * 0.32), 1)
			else
				w.AutomaticSize = Enum.AutomaticSize.X
				w.Size = UDim2.new(0, 0, 1, 0)
				local l = Instance.new("TextLabel")
				l.BackgroundTransparency = 1
				l.AutomaticSize = Enum.AutomaticSize.X
				l.Size = UDim2.new(0, 0, 1, 0)
				l.Font = Enum.Font.GothamBold
				l.TextSize = size
				l.TextXAlignment = Enum.TextXAlignment.Left
				l.TextColor3 = DIM
				l.Text = ch
				l.Parent = w
				table.insert(out, l)
			end
		end
		return out
	end
	local row1 = Instance.new("Frame")
	row1.BackgroundTransparency = 1
	row1.Position = UDim2.fromOffset(78, 12)
	row1.Size = UDim2.fromOffset(W - 92, 22)
	row1.Parent = card
	local row2 = Instance.new("Frame")
	row2.BackgroundTransparency = 1
	row2.Position = UDim2.fromOffset(78, 37)
	row2.Size = UDim2.fromOffset(W - 92, 18)
	row2.Parent = card
	local L1 = letters(row1, line1, 18)
	local L2 = letters(row2, line2, 14)

	local N = 34
	local waveBox = Instance.new("Frame")
	waveBox.BackgroundTransparency = 1
	waveBox.Position = UDim2.fromOffset(16, 62)
	waveBox.Size = UDim2.fromOffset(W - 32, 16)
	waveBox.Parent = card
	local bars = {}
	for i = 1, N do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0.5, 1)
		b.Position = UDim2.new((i - 0.5) / N, 0, 1, 0)
		b.Size = UDim2.new(0.5 / N, 0, 0.3, 0)
		b.BackgroundColor3 = LIGHT
		b.BorderSizePixel = 0
		b.Parent = waveBox
		round(b, UDim.new(1, 0))
		bars[i] = b
	end

	local track = Instance.new("Frame")
	track.Position = UDim2.fromOffset(16, H - 9)
	track.Size = UDim2.fromOffset(W - 32, 3)
	track.BackgroundColor3 = Color3.fromRGB(34, 35, 40)
	track.BorderSizePixel = 0
	track.Parent = card
	round(track, UDim.new(1, 0))
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	fill.BorderSizePixel = 0
	fill.Parent = track
	round(fill, UDim.new(1, 0))
	local fg = Instance.new("UIGradient")
	fg.Color = CHROME
	fg.Parent = fill

	local start = tick()
	local function waveText(list, t, amp, speed, step)
		for i, l in ipairs(list) do
			l.Position = UDim2.fromOffset(0, math.sin(t * speed - i * step) * amp)
			local s = (math.sin(t * speed * 0.8 - i * step) + 1) / 2
			l.TextColor3 = DIM:Lerp(LIGHT, s * s)
		end
	end
	notifyConn = RunService.RenderStepped:Connect(function()
		local t = tick() - start
		sg.Rotation = (t * 120) % 360
		ig.Rotation = (-t * 200) % 360
		fg.Offset = Vector2.new(math.sin(t * 2) * 0.35, 0)
		bg.Rotation = 90 + math.sin(t * 0.8) * 25
		shg.Offset = Vector2.new(((t * 0.55) % 2) - 1, 0)
		icon.Size = UDim2.fromOffset(48 + math.sin(t * 3) * 2, 48 + math.sin(t * 3) * 2)
		waveText(L1, t, 2.4, 5, 0.45)
		waveText(L2, t, 1.6, 5, 0.38)
		for i, b in ipairs(bars) do
			local v = (math.sin(t * 4.2 - i * 0.36) + 1) / 2
			local v2 = (math.sin(t * 2.3 + i * 0.21) + 1) / 2
			local h = 0.14 + 0.86 * (v * 0.7 + v2 * 0.3) ^ 1.4
			b.Size = UDim2.new(0.5 / N, 0, h, 0)
			b.BackgroundColor3 = DIM:Lerp(LIGHT, v * v)
		end
	end)

	TweenService:Create(card, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0, 16)}):Play()
	TweenService:Create(card, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
	task.delay(0.7, function()
		if ng.Parent then
			TweenService:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.fromScale(0, 1)}):Play()
		end
	end)
	task.delay(0.7 + duration, function()
		if not ng.Parent then return end
		local tw = TweenService:Create(card, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
			{Position = UDim2.new(0.5, 0, 0, -H - 24), GroupTransparency = 1})
		tw:Play()
		tw.Completed:Wait()
		pcall(function() if notifyConn then notifyConn:Disconnect() end end)
		pcall(function() ng:Destroy() end)
	end)
end

