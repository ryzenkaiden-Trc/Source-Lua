	idleHand = OPTIONS.Pistol.TwoHanded and "HG" or "IDLE", twoHanded = OPTIONS.Pistol.TwoHanded,
	autoReload = OPTIONS.Pistol.AutoReload, sndPitch = 1.25, aimFovMul = OPTIONS.Pistol.AimFOVMul,
	iPivot = Vector3.new(0.05, 0.14, -0.09), iOff = Vector3.new(-0.5, 0.3, 0.4),
	dropVel = Vector3.new(-0.6, 0.3, -1.2),
	damage = function(dist, head)
		local o = OPTIONS.Pistol
		local a = math.clamp((dist - o.FalloffStart) / math.max(1, o.FalloffEnd - o.FalloffStart), 0, 1)
		local d = o.Damage + (o.DamageFar - o.Damage) * a
		return head and d * o.HeadMult or d
	end,
	relPose = function(tl)
		return CFrame.new(-0.40 * tl, 0.20 * tl, 0.15 * tl) * CFrame.Angles(0.25 * tl, 0.35 * tl, -0.65 * tl)
	end,
	twirlPivot = Vector3.new(0.05, 0.10, 0.12),
	flourish = function(gl, gy, gr, gs)
		if gl < 0.001 and gr == 0 and gs == 0 then return CFrame.new() end
		local S = RIGS.PISTOL.S
		local pv = Vector3.new(0.05, 0.10, 0.12) * S
		return CFrame.new(-0.30 * gl, 0.34 * gl, 0.15 * gl) * CFrame.new(pv)
			* CFrame.Angles(gs, 0, 0) * CFrame.Angles(0, 0, gr) * CFrame.new(-pv)
	end,
	sway = function(t, kRaw, aimA, speed)
		if speed > 20 then
			local a = t * 4.5 * 1.5
			local pos = Vector3.new(math.sin(t * 3.5 * 1.5) * 4 / 30, math.sin(t * 9 * 1.5) * 1.5 / 40 + 0.2, 0)
			return CFrame.new(pos) * CFrame.Angles(0, -math.rad(math.sin(a)) * 5 + 0.05235987755982989, math.rad(math.sin(a)) * 5)
		end
		local idleU = Vector3.new(math.sin(t / 2) / 70, math.sin(t * 5 / 4) / 70, math.sin(t * 3 / 4) / 70)
		local idleA = Vector3.new(math.sin(t * 3 / 8) / 140, math.sin(t * 15 / 16) / 140, 0)
		local walkU = Vector3.new(math.sin(t * 4.5) * 4 / 50, math.sin(t * 9) * 1.5 / 50, 0)
		local walkA = Vector3.new(math.sin(t * 3) * 2 / 150, math.sin(t * 6) * 0.75 / 150, 0)
		local rotU = math.rad(math.sin(t * 4.5)) * 2
		local rotA = math.rad(math.sin(t * 3)) / 3
		local idle = idleU:Lerp(idleA, aimA)
		local walk = walkU:Lerp(walkA, aimA)
		local rz = (rotU + (rotA - rotU) * aimA) * kRaw
		return CFrame.new(idle + walk * kRaw) * CFrame.Angles(0, 0, rz)
	end,
	pts = {
		R_HAND = Vector3.new(0.05, -0.18, 0.40),
		L_HG   = Vector3.new(-0.34, -0.20, 0.08),
