			splatRay(pos, Vector3.new(0, -12, 0), mdl, 1.3)
		end
	end

	local function breakLimb(part, base, forceAxis)
		local cf, size, color = part.CFrame, part.Size, part.Color
		local axis = forceAxis
		if not axis then
			axis = "Y"
			if size.X > size.Y and size.X >= size.Z then axis = "X"
			elseif size.Z > size.Y and size.Z > size.X then axis = "Z" end
		end
		local L = size[axis]
		local axisVec = cf[axis .. "Vector"]
		local rot = rotOnly(cf)
		local function dims(len, cross)
			return Vector3.new(axis == "X" and len or size.X * cross, axis == "Y" and len or size.Y * cross, axis == "Z" and len or size.Z * cross)
		end
		local t = rng:NextNumber(0.35, 0.65)
		local lenA, lenB = L * t, L * (1 - t)
		local cutPos = cf.Position + axisVec * (-L / 2 + lenA)
		local A = gibPart(dims(lenA, 1), color, CFrame.new(cf.Position + axisVec * (-L / 2 + lenA / 2)) * rot)
		local B = gibPart(dims(lenB, 1), color, CFrame.new(cf.Position + axisVec * (L / 2 - lenB / 2)) * rot)
		local fa = gibPart(dims(0.07, 0.9), BLOOD, CFrame.new(cutPos + axisVec * 0.035) * rot)
		local fb = gibPart(dims(0.07, 0.9), BLOOD, CFrame.new(cutPos - axisVec * 0.035) * rot)
		weldTo(A, fa)
		weldTo(B, fb)

		local crossMin
		if axis == "X" then crossMin = math.min(size.Y, size.Z)
		elseif axis == "Y" then crossMin = math.min(size.X, size.Z)
		else crossMin = math.min(size.X, size.Y) end
		local th = math.clamp(crossMin * 0.28, 0.1, 0.3)
		local bl = math.clamp(L * 0.6, 0.45, 1.5)
		local boneBase = CFrame.lookAt(cutPos, cutPos + axisVec) * CFrame.Angles(0, math.rad(90), 0)
		local bone = gibPart(Vector3.new(bl, th, th), BONE, boneBase * CFrame.new(0.15 * bl, 0, 0), {cyl = true})
		weldTo(A, bone)
		local stub = gibPart(Vector3.new(0.45, th * 1.3, th * 1.3), BONE, boneBase * CFrame.new(-0.025, 0, 0), {cyl = true})
		weldTo(B, stub)

		launch(A, base * rng:NextNumber(0.5, 0.9), 12)
		launch(B, base * rng:NextNumber(0.6, 1.0), 12)
		bleed(A, 1.6)
		bleed(B, 1.6)
	end

	local function burstTorso(part, base)
		local cf = part.CFrame
		local c = cf.Position
		breakLimb(part, base, "Y")

		local function at(off) return CFrame.new(c + cf:VectorToWorldSpace(off)) end
		local function organ(size, color, off)
			local p = gibPart(Vector3.new(size, size, size), color, at(off), {ball = true})
			p.Reflectance = 0.12
			launch(p, base * rng:NextNumber(0.4, 0.8), 14)
		end
		organ(0.55, Color3.fromRGB(150, 10, 20), Vector3.new(0.4, 0.4, -0.2))
		organ(0.8, Color3.fromRGB(215, 125, 140), Vector3.new(-0.5, 0.5, 0))
		organ(0.8, Color3.fromRGB(215, 125, 140), Vector3.new(0.5, 0.5, 0))
		organ(0.75, Color3.fromRGB(110, 28, 30), Vector3.new(0.6, -0.4, 0))
		organ(0.5, Color3.fromRGB(190, 110, 100), Vector3.new(-0.5, -0.3, 0))

		local prevAtt
		for i = 1, 8 do
			local bead = gibPart(Vector3.new(0.34, 0.34, 0.34), Color3.fromRGB(225, 160, 150), at(Vector3.new((i - 4.5) * 0.25, -0.7, 0)), {ball = true})
			bead.Reflectance = 0.1
			local att = Instance.new("Attachment")
			att.Parent = bead
			if prevAtt then
				local rope = Instance.new("RopeConstraint")
				rope.Attachment0, rope.Attachment1 = prevAtt, att
				rope.Length = 0.4
				rope.Visible = false
				rope.Parent = bead
			end
			prevAtt = att
			launch(bead, base * 0.5, 10)
		end

		for _ = 1, 6 do
			local p = gibPart(Vector3.new(0.12, 0.12, rng:NextNumber(0.6, 1)), BONE,
				at(Vector3.new(rng:NextNumber(-0.6, 0.6), rng:NextNumber(-0.3, 0.7), rng:NextNumber(-0.3, 0.3))) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0))
			launch(p, base * rng:NextNumber(0.5, 0.9), 14)
		end

		local root
		for i = 1, 5 do
			local v = gibPart(Vector3.new(0.3, 0.22, 0.3), BONE, at(Vector3.new(0, 0.5 - i * 0.25, 0.35)))
			if root then weldTo(root, v) else root = v end
		end
		launch(root, base * 0.6, 8)

		for _ = 1, 6 do
			local s = rng:NextNumber(0.25, 0.45)
			local p = gibPart(Vector3.new(s, s * 0.7, s), BLOOD_D, at(Vector3.new(rng:NextNumber(-0.6, 0.6), rng:NextNumber(-0.6, 0.6), 0)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0))
			launch(p, base * rng:NextNumber(0.4, 0.9), 14)
		end
	end

	local function burstHead(part, base, shatter)
		local cf = part.CFrame
		local c = cf.Position
		if not shatter then
			local p = gibPart(part.Size, part.Color, cf)
			bleed(p, 2)
			launch(p, base, 8)
			return
		end
		mist(c, base.Unit, 40, 10, 34)
		mist(c, Vector3.yAxis, 25, 8, 22)
		local function jitter(k) return Vector3.new(rng:NextNumber(-k, k), rng:NextNumber(-k, k), rng:NextNumber(-k, k)) end
		for _ = 1, 9 do
			local s = rng:NextNumber(0.18, 0.42)
			local p = gibPart(Vector3.new(s, s * rng:NextNumber(0.5, 1), s * rng:NextNumber(0.5, 1)), BONE,
				CFrame.new(c + jitter(0.4)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0))
			launch(p, base * rng:NextNumber(0.5, 1), 16)
		end
		for _ = 1, 4 do
			local s = rng:NextNumber(0.35, 0.55)
			local p = gibPart(Vector3.new(s, s, s), Color3.fromRGB(235, 160, 175), CFrame.new(c + jitter(0.25)), {ball = true})
			p.Reflectance = 0.1
			launch(p, base * rng:NextNumber(0.4, 0.8), 12)
		end
		for sgn = -1, 1, 2 do
			local p = gibPart(Vector3.new(0.22, 0.22, 0.22), Color3.fromRGB(240, 240, 240), CFrame.new(c + cf:VectorToWorldSpace(Vector3.new(0.2 * sgn, 0.1, -0.3))), {ball = true})
			launch(p, base * 0.7, 12)
		end
		for _ = 1, 5 do
			local s = rng:NextNumber(0.2, 0.35)
			local p = gibPart(Vector3.new(s, s, s), BLOOD_D, CFrame.new(c + jitter(0.3)))
			launch(p, base * rng:NextNumber(0.4, 0.9), 14)
		end
	end

	local function hideInst(i)
		if i:IsA("BasePart") then
			i.LocalTransparencyModifier = 1
			table.insert(goreHidden, {i, "LocalTransparencyModifier", 0})
		elseif i:IsA("Decal") or i:IsA("Texture") then
			table.insert(goreHidden, {i, "Transparency", i.Transparency})
			i.Transparency = 1
		end
	end

	gibKill = function(mdl, dir, headshot)
		gored[mdl] = true
		local d = dir.Unit
		local base = d * 22
		local head = mdl:FindFirstChild("Head")

		if headshot and head and head:IsA("BasePart") then
			hideInst(head)
			for _, ch in ipairs(head:GetChildren()) do hideInst(ch) end
			for _, acc in ipairs(mdl:GetChildren()) do
				if acc:IsA("Accessory") then
					local h = acc:FindFirstChild("Handle")
					local w = h and h:FindFirstChild("AccessoryWeld")
					if w and (w.Part0 == head or w.Part1 == head) then
						for _, x in ipairs(acc:GetDescendants()) do hideInst(x) end
					end
				end
			end
			burstHead(head, base, true)
			return
		end

		table.insert(goredList, mdl)
		local limbs = {}
		for _, ch in ipairs(mdl:GetChildren()) do
			if ch:IsA("BasePart") and ch.Name ~= "HumanoidRootPart" then table.insert(limbs, ch) end
		end
		for _, x in ipairs(mdl:GetDescendants()) do hideInst(x) end
		local hum = mdl:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end) end

		local center = (head and head.Position) or (mdl:GetPivot().Position)
		local torsoPos
		for _, p in ipairs(limbs) do
			local n = p.Name
			if n == "Head" then
				burstHead(p, base, false)
			elseif n == "Torso" or n == "UpperTorso" then
				torsoPos = p.Position
				burstTorso(p, base)
			elseif math.max(p.Size.X, p.Size.Y, p.Size.Z) >= 0.9 then
				breakLimb(p, base)
			else
				local g = gibPart(p.Size, p.Color, p.CFrame)
				launch(g, base * 0.8, 10)
			end
		end
		local c = torsoPos or center

		for i = 0, 5 do
			task.delay(i * 0.25, function()
				if fxFolder.Parent then mist(c, Vector3.new(rng:NextNumber(-0.5, 0.5), 1, rng:NextNumber(-0.5, 0.5)), 18, 8, 24) end
			end)
		end
		for _ = 1, 10 do
			local v = (d * 0.6 + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.3, 1), rng:NextNumber(-1, 1))).Unit
			splatRay(c, v * 16, mdl, rng:NextNumber(1.5, 3))
		end
		task.delay(0.8, function()
			if not fxFolder.Parent then return end
			setFilter(mdl)
			local res = workspace:Raycast(c, Vector3.new(0, -30, 0), goreRay)
			if res then
				local p = disc(res.Position, res.Normal, 0.5)
				TweenService:Create(p, TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = Vector3.new(0.03, 7, 7)}):Play()
			end
		end)
	end
end

local reload

local function fire()
	local rig = cur
	if reloading or inspecting or swPending or swA > 0.05 then return end
	if rig.modes[rig.mode] == "SAFE" then
		if not clicked then clicked = true play("Click") end
		return
	end
	local now = tick()
	if now - lastShot < 60 / rig.fireRate then return end
	if rig.ammo <= 0 then
		if not clicked then
			clicked = true
			play("Click")
			if rig.autoReload then reload() end
		end
		return
	end
	lastShot = now
	rig.ammo = rig.ammo - 1
	if rig.ammo <= 0 and rig.lockIdx then
		rig.locked = true
		applyLock(rig)
	end
	refreshHUD()
	play("Fire")
	muzzleFlash()

	local spread = math.rad(aiming and rig.spreadAim or rig.spreadHip) * (crouching and 0.7 or 1)
	local cf = cam.CFrame * CFrame.Angles((math.random() - 0.5) * spread, (math.random() - 0.5) * spread, 0)
	local origin, dir = cf.Position, cf.LookVector * 1500
	local ex = {model, fxFolder}
	if LP.Character then table.insert(ex, LP.Character) end
	for _, g in ipairs(goredList) do table.insert(ex, g) end
	rayParams.FilterDescendantsInstances = ex
	local res = workspace:Raycast(origin, dir, rayParams)
	local endPos = res and res.Position or origin + dir
	tracer(rig.fireP.Position, endPos)

	if res then
		local hum, mdl = findHumanoid(res.Instance)
		if hum and hum.Health > 0 then
			local isHead = res.Instance.Name == "Head"
			local dmg = rig.damage((res.Position - origin).Magnitude, isHead)
			local before = math.min(hum.Health, localHP[hum] or hum.Health)
			local after = before - dmg
			localHP[hum] = after
			if OPTIONS.LocalDamage then
				pcall(function() hum:TakeDamage(dmg) end)
			end
			hitmarker()
			play("BodyHit", 0.6)

			if OPTIONS.Blood then pcall(bloodHit, res, dir, mdl, isHead) end
			if OPTIONS.Gore and before > 0 and after <= 0 and mdl and not gored[mdl] then
				pcall(gibKill, mdl, dir, isHead)
			end
		else
			spark(res.Position, res.Normal)
			bulletHole(res.Position, res.Normal)
		end
	end

	local rc = aiming and rig.recoilAim or rig.recoilHip
	sp.rz[2] = sp.rz[2] + rc.rz
	sp.rp[2] = sp.rp[2] + rc.rp
	sp.cam[2] = sp.cam[2] + rc.cam
	sp.bolt[2] = sp.bolt[2] + rig.slideKick
end

local lastMagCF = CFrame.new()

local function dropMag()
	local rig = cur
	local m = rig.mag:Clone()
	m.Anchored = true
	m.Transparency = 0
	m.CFrame = lastMagCF
	m.Parent = fxFolder
	local vel = cam.CFrame:VectorToWorldSpace(rig.dropVel)
	local spin = Vector3.new(math.random() * 20 - 10, math.random() * 20 - 10, math.random() * 20 - 10)
	task.spawn(function()
		local t = 0
		while t < 0.9 and m.Parent do
			local dt = RunService.Heartbeat:Wait()
			t = t + dt
			vel = vel + Vector3.new(0, -50, 0) * dt
			m.CFrame = CFrame.new(m.Position + vel * dt) * (rotOnly(m.CFrame) * CFrame.Angles(spin.X * dt, spin.Y * dt, spin.Z * dt))
			if t > 0.5 then m.Transparency = math.clamp((t - 0.5) / 0.4, 0, 1) end
		end
		m:Destroy()
	end)
end

local EASE = {
	smooth = function(a) return a * a * (3 - 2 * a) end,
	out    = function(a) return 1 - (1 - a) * (1 - a) end,
	inn    = function(a) return a * a end,
	lin    = function(a) return a end,
}

RIGS.AK47.reloadSeq = function(phase)
	local STYLE = OPTIONS.JohnWickReloadStylish ~= false
	local f = STYLE and 0.78 or 1
	if not phase(0.32 * f, {tilt = 1, hand = "MW"}, "out") then return false end
	rl.magState = 1
	if not phase(0.10 * f, {rock = 0.25}) then return false end
	play("MagOut")
	if not phase(0.28 * f, {hand = "OUT", rock = 0.55}, "inn") then return false end
	dropMag()
	rl.magState = 2
	if not phase(0.22 * f, {hand = "PCH"}) then return false end
	rl.rock = 0.1
	rl.magState = 1
	if not phase(0.12 * f, {}) then return false end
	if not phase(0.32 * f, {hand = "INS", rock = 0.5}) then return false end
	play("MagIn")
	if not phase(0.14 * f, {hand = "MW", rock = 0}, "out") then return false end
	rl.magState = 0
	sp.rp[2] = sp.rp[2] + (STYLE and 0.95 or 0.6)
	sp.cam[2] = sp.cam[2] + (STYLE and 0.45 or 0.3)
	if not phase(0.34 * f, {rack = 1, hand = "BLT"}) then return false end
	play("BoltBack")
	if not phase(0.16 * f, {boltZ = 0.7}, "out") then return false end
	play("BoltForward")
	if not phase(0.09 * f, {boltZ = 0}, "inn") then return false end
	sp.rz[2] = sp.rz[2] + (STYLE and 1.1 or 0.8)
	sp.cam[2] = sp.cam[2] + (STYLE and 0.35 or 0.2)
	if not phase(0.45 * f, {tilt = 0, rack = 0, hand = "HG"}, "out") then return false end
	return true
end

RIGS.PISTOL.reloadSeq = function(phase)
	local rig = RIGS.PISTOL
	local STYLE = OPTIONS.JohnWickReloadStylish ~= false
	local wasEmpty = rig.ammo <= 0
	local k = wasEmpty and (1.6 / 1.3) or (1.3 / 0.9)
	if STYLE then k = k * 0.8 end
	if not phase(0.20 * k, {tilt = 1, hand = "MW", rock = 0, rhi = 1}, "out") then return false end
	rl.magState = 1
	play("MagOut")
	if not phase(0.06 * k, {hand = "INS", rock = 0}, "lin") then return false end
	if not phase(0.06 * k, {hand = "OUT", rock = 0.5}, "lin") then return false end
	dropMag()
	rl.magState = 2
	if not phase(0.13 * k, {hand = "PCH"}) then return false end
	rl.rock = 0.1
	rl.magState = 1
	if not phase(0.20 * k, {hand = "INS", rock = 0}) then return false end
	play("MagIn")
	if not phase(0.10 * k, {hand = "MW", rock = 0}, STYLE and "inn" or "out") then return false end
	rl.magState = 0
	sp.rp[2] = sp.rp[2] + (STYLE and 0.9 or 0.5)
	sp.cam[2] = sp.cam[2] + (STYLE and 0.45 or 0.25)
	if STYLE then
		if not phase(0.14 * k, {hand = "BLT"}) then return false end
		play("BoltBack")
		if not phase(0.07 * k, {boltZ = 0.45}, "out") then return false end
		play("BoltForward")
		if rig.locked then
			rig.locked = false
			applyLock(rig)
		end
		if not phase(0.04 * k, {boltZ = 0}, "inn") then return false end
		sp.rz[2] = sp.rz[2] + 0.7
		sp.rp[2] = sp.rp[2] + 0.3
		sp.cam[2] = sp.cam[2] + 0.25
	elseif rig.locked then
		rig.locked = false
		applyLock(rig)
		play("BoltForward")
		sp.bolt[1] = 0.2 / rig.slideK
		sp.rz[2] = sp.rz[2] + 0.5
	end
	if not phase(0.24 * k, {tilt = 0, rhi = 0, hand = rig.idleHand}, "out") then return false end
	return true
end

