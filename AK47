local function makeMeshPart(meshId)
	local ok, res = pcall(function()
		return InsertService:CreateMeshPartAsync(meshId, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Automatic)
	end)
	if ok and res then return res end

	local mp = Instance.new("MeshPart")
	local ok2 = pcall(function() mp.MeshId = meshId end)
	if ok2 and mp.MeshId ~= "" then
		pcall(function() ContentProvider:PreloadAsync({mp}) end)
		return mp
	end
	warn("[Weapons] mesh failed: " .. tostring(meshId))
	return mp
end

local function nativeSize(mp)
	local ok, s = pcall(function() return mp.MeshSize end)
	if ok and typeof(s) == "Vector3" and s.X > 0.001 and s.Y > 0.001 and s.Z > 0.001 then
		return s
	end
	return nil
end

local function build(def, parent, S, trust)
	local cls, name, props, kids = def[1], def[2], def[3], def[4]
	local isMesh = (cls == "MeshPart")
	local inst = isMesh and makeMeshPart(props.MeshId) or Instance.new(cls)
	inst.Name = name

	local sizeV = (typeof(props.Size) == "Vector3") and props.Size or nil
	for k, v in pairs(props) do
		if k ~= "_note" and not (isMesh and k == "MeshId") and not (k == "Size" and sizeV) then
			if k == "TextureID" and OPTIONS.SkinTextureId and v ~= "" then v = OPTIONS.SkinTextureId end
			pcall(function() inst[k] = v end)
		end
	end

	if sizeV then
		local size = sizeV
		if isMesh and not trust then
			local nat = nativeSize(inst)
			if nat then
				if (nat - sizeV).Magnitude > 0.03 * sizeV.Magnitude then
					warn(("[Weapons] %s: stored size (%.2f, %.2f, %.2f) doesn't match the mesh (%.2f, %.2f, %.2f) - using the mesh's real size")
						:format(name, sizeV.X, sizeV.Y, sizeV.Z, nat.X, nat.Y, nat.Z))
				end
				size = nat
			end
		end
		pcall(function() inst.Size = size * S end)
	end

	if kids then for _, kd in ipairs(kids) do build(kd, inst, S, trust) end end
	inst.Parent = parent
	return inst
end

