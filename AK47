local function scaleSeq(seq, k)
	local kps = {}
	for i, kp in ipairs(seq.Keypoints) do
		kps[i] = NumberSequenceKeypoint.new(kp.Time, kp.Value * k, kp.Envelope * k)
	end
	return NumberSequence.new(kps)
end

local function buildRig(cfg)
	local S = cfg.scale
	local rig = {cfg = cfg, S = S, name = cfg.name}
	local m = Instance.new("Model")
	m.Name = cfg.name
	rig.model = m
	rig.parts, rig.byName, rig.LOCAL = {}, {}, {}

	for i, def in ipairs(cfg.parts) do
		local p = build(def, m, S, cfg.trustSize)
		p.Anchored = true
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
		p.CastShadow = false
		p.Massless = true
		rig.parts[i] = p
		rig.byName[p.Name] = rig.byName[p.Name] or p
		local c0 = cfg.c0[i]
		if c0 then
			local b = cfg.inverse and c0:Inverse() or c0
			rig.LOCAL[i] = CFrame.new(b.Position * S) * rotOnly(b)
		else
			rig.LOCAL[i] = CFrame.new()
		end
	end

	local by = rig.byName
	rig.fireP = by.FirePart
	rig.mag = by.Mag
	rig.magI = table.find(rig.parts, by.Mag)
	rig.slideIdx = {}
	for _, n in ipairs(cfg.slide) do table.insert(rig.slideIdx, table.find(rig.parts, by[n])) end
	if cfg.lock then
		rig.lockIdx = {}
		for _, n in ipairs(cfg.lock) do table.insert(rig.lockIdx, table.find(rig.parts, by[n])) end
	end
	rig.slideK, rig.slideKick = cfg.slideK, cfg.slideKick

	for _, d in ipairs(rig.fireP:GetDescendants()) do
		if d:IsA("ParticleEmitter") then
			pcall(function() d.Size = scaleSeq(d.Size, S) end)
		elseif d:IsA("PointLight") then
			d.Range = d.Range * S
		end
	end

	rig.sfx = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("Sound") then rig.sfx[d.Name] = d end
	end
	for _, s in pairs(rig.sfx) do
		s.RollOffMode = Enum.RollOffMode.Linear
		s.Parent = gui
	end

	rig.aimLocal = rig.LOCAL[table.find(rig.parts, by.AimPart)].Position
	rig.HIP = cfg.hip
	rig.ADS = CFrame.new(-rig.aimLocal.X, -0.02 - rig.aimLocal.Y, -cfg.aimDist - rig.aimLocal.Z)
	rig.magC = rig.LOCAL[rig.magI].Position / S
	rig.MAGROT = rotOnly(rig.LOCAL[rig.magI])
	local P = {}
	for k, v in pairs(cfg.pts) do P[k] = v end
	P.L_MW = rig.magC - Vector3.new(0, P.MAG_HOLD, 0)
	P.L_INS = P.L_MW + P.insOff
	rig.pts = P

	for _, k in ipairs({"modes", "mode", "magSize", "fireRate", "spreadHip", "spreadAim", "recoilHip", "recoilAim",
		"idleHand", "dropVel", "damage", "relPose", "sway", "autoReload", "sndPitch", "aimFovMul", "twoHanded",
		"flourish", "twirlPivot", "iPivot", "iOff"}) do
		rig[k] = cfg[k]
	end
	rig.ammo = cfg.magSize
	rig.locked = false
	return rig
end

