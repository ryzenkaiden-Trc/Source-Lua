	icon.BorderSizePixel = 0
	icon.Parent = card
	round(icon, UDim.new(1, 0))
	local is = Instance.new("UIStroke")
	is.Thickness = 2.2
	is.Color = Color3.new(1, 1, 1)
	is.Parent = icon
	local ig = Instance.new("UIGradient")
