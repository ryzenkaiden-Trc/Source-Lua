		Debris:AddItem(p, OPTIONS.BloodLifetime or 30)
		return p
	end

	local function splatRay(origin, direction, extra, size)
		setFilter(extra)
		local res = workspace:Raycast(origin, direction, goreRay)
		if not res then return nil end
		local n = res.Normal
		disc(res.Position, n, size * rng:NextNumber(0.7, 1.2))
		local tan = n:Cross(math.abs(n.Y) > 0.9 and Vector3.xAxis or Vector3.yAxis).Unit
		local bit = tan:Cross(n)
		for _ = 1, rng:NextInteger(2, 4) do
			local a = rng:NextNumber(0, 6.283)
			local off = (tan * math.cos(a) + bit * math.sin(a)) * size * rng:NextNumber(0.4, 0.9)
			disc(res.Position + off, n, size * rng:NextNumber(0.15, 0.4))
		end
		return res
	end

	bloodHit = function(res, dir, mdl, headshot)
		local pos, n, d = res.Position, res.Normal, dir.Unit
		mist(pos, n, headshot and 22 or 12, 8, 22)
		mist(pos + d * 0.5, d, headshot and 18 or 8, 10, 26)
		for _ = 1, headshot and 9 or 5 do
			local p = mkPart(Vector3.new(0.16, 0.16, 0.16), BLOOD, {ball = true})
			p.CFrame = CFrame.new(pos + n * 0.2)
			p.Parent = fxFolder
			p.AssemblyLinearVelocity = (n + d + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0, 1.2), rng:NextNumber(-1, 1))).Unit * rng:NextNumber(10, 28)
			Debris:AddItem(p, 1.5)
		end
		splatRay(pos + d * 1.0, d * 30, mdl, headshot and 2.2 or 1.4)
