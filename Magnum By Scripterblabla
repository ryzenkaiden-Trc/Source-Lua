local ID = CFrame.new()

local function smooth(a)
    if a < 0 then a = 0 elseif a > 1 then a = 1 end
    return a * a * (3 - 2 * a)
end
local function approach(v, target, step)
    if v < target then return math.min(v + step, target) end
    return math.max(v - step, target)
end
local function newSpring(k, d)
    return { p = Vector3.new(0, 0, 0), v = Vector3.new(0, 0, 0), k = k, d = d }
end
local function stepSpring(s, dt)
    local n = 3
    local h = math.min(dt, 0.05) / n
    for _ = 1, n do
        local a = s.p * (-s.k) - s.v * s.d
        s.v = s.v + a * h
        s.p = s.p + s.v * h
    end
end
local function cf12(t)
    return CFrame.new(t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12])
end
local function rnd(a, b) return a + (b - a) * math.random() end

local function findPart(root, name)
    for _, d in ipairs(root:GetDescendants()) do
        if d.Name == name and d:IsA("BasePart") then return d end
    end
    return nil
end

local function validModel(m)
    if not (m and m:IsA("Model")) then return false end
    for _, n in ipairs({ "Grip", "AimPart", "AnimBase", "Left Arm", "Right Arm", "Loader", "Cylinder", "Hammer" }) do
        if not findPart(m, n) then return false end
    end
    return true
end

local function ensureFile(fileName)
    if not isfile then return nil, "isfile not supported" end
    local candidates = {}
    if CONFIG.FileDir and CONFIG.FileDir ~= "" then
        candidates[#candidates + 1] = CONFIG.FileDir .. "/" .. fileName
    end
    candidates[#candidates + 1] = fileName
    for _, p in ipairs(candidates) do
        local ok, ex = pcall(isfile, p)
        if ok and ex then return p end
    end
    return nil, "file not found: " .. fileName
end

local function loadObjects(path)
    local getasset = getcustomasset or getsynasset or get_custom_asset
    if not getasset then return nil, "no getcustomasset" end
    local ok, asset = pcall(getasset, path)
    if not ok or not asset then return nil, tostring(asset) end
    local objs
    local ok2, res = pcall(function() return game:GetObjects(asset) end)
    if ok2 and type(res) == "table" then objs = res end
    if not objs then
        local ok3, obj = pcall(function() return InsertService:LoadLocalAsset(asset) end)
        if ok3 and obj then objs = { obj } end
    end
    if not objs then return nil, "GetObjects failed" end
    return objs
end

local function tryLoadFile(path)
    local objs, why = loadObjects(path)
    if not objs then return nil, why end
    local found
    for _, o in ipairs(objs) do
        if not found and validModel(o) then found = o else pcall(function() o:Destroy() end) end
    end
    if not found then return nil, "model missing required parts" end
    return found
end

local function buildFallback()
    local model = Instance.new("Model")
    model.Name = "Revolver"
    local by = {}
    for _, p in ipairs(FB.parts) do
        local name, kind, size, cf, tr, col, mesh, tex, init = p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], p[9]
        local part
        if kind == "M" then
            local ok, mp = pcall(function()
                return InsertService:CreateMeshPartAsync(mesh, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Automatic)
            end)
            if ok and mp then
                part = mp
                if tex ~= "" then
                    local sa = Instance.new("SurfaceAppearance")
                    sa.ColorMap = tex
                    sa.Parent = part
                end
            else
                part = Instance.new("Part")
                local sm = Instance.new("SpecialMesh")
                sm.MeshType = Enum.MeshType.FileMesh
                sm.MeshId = mesh
                sm.TextureId = tex
                sm.Scale = Vector3.new(size[1] / init[1], size[2] / init[2], size[3] / init[3])
                sm.Parent = part
            end
        else
            part = Instance.new("Part")
        end
        part.Name = name
        part.Size = Vector3.new(size[1], size[2], size[3])
        part.Color = Color3.new(col[1], col[2], col[3])
        part.Transparency = tr
        part.CFrame = cf12(cf)
        part.Anchored = true
        part.Parent = model
        by[name] = part
    end
    for _, j in ipairs(FB.joints) do
        local p0, p1 = by.Grip, by[j[3]]
        if p0 and p1 then
            local w = Instance.new(j[1])
            w.Name = j[2]
            w.Part0 = p0
            w.Part1 = p1
            w.C0 = cf12(j[4])
            w.C1 = cf12(j[5])
            w.Parent = p0
        end
    end
    for _, s in ipairs(FB.sounds) do
        local snd = Instance.new("Sound")
        snd.Name = s[1]
        snd.SoundId = s[2]
        snd.Volume = s[3]
        snd.Parent = by.Grip
    end
    for _, a in ipairs(FB.attach) do
        local att = Instance.new("Attachment")
        att.Name = a[1]
        att.CFrame = cf12(a[2])
        att.Parent = by.Grip
        if a[1] == "Muzzle" then
            local pe = Instance.new("ParticleEmitter")
            pe.Name = "Flash"
