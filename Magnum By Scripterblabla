local shells = {}

local function ejectShells()
    local cam = Workspace.CurrentCamera
    for _, s in ipairs(ORDER) do
        local src = nil
        if s.state == "spent" then src = s.casing elseif s.state == "live" then src = s.bullet end
        if src and cam then
            local c = src:Clone()
            c.Transparency = 0
            c.Anchored = true
            c.CanCollide = false
            c.CanTouch = false
            c.CanQuery = false
            c.CastShadow = false
            c.CFrame = src.CFrame
            c.Parent = fxFolder
            shells[#shells + 1] = {
                p = c, age = 0, rest = false,
                v = cam.CFrame:VectorToWorldSpace(Vector3.new(rnd(0.5, 2), rnd(0, 1.2), rnd(-1.5, 0.3))),
                w = Vector3.new(rnd(-10, 10), rnd(-10, 10), rnd(-10, 10)),
            }
        end
        s.state = "empty"
    end
    refreshSlots()
end

local function updateShells(dt)
    local rp
    for i = #shells, 1, -1 do
        local s = shells[i]
        s.age = s.age + dt
        if s.age > 4 or not s.p.Parent then
            pcall(function() s.p:Destroy() end)
            table.remove(shells, i)
        elseif not s.rest then
            s.v = s.v + Vector3.new(0, -Workspace.Gravity, 0) * dt
            local cf = s.p.CFrame
            local rot = cf - cf.Position
            local move = s.v * dt
            rp = rp or rayParams()
            local res = Workspace:Raycast(cf.Position, move, rp)
            if res then
                s.p.CFrame = CFrame.new(res.Position + res.Normal * 0.05) * rot
                s.rest = true
            else
                local w = s.w * dt
                s.p.CFrame = CFrame.new(cf.Position + move) * rot * CFrame.Angles(w.X, w.Y, w.Z)
            end
        end
    end
end

