local function doShot()
    local cam = Workspace.CurrentCamera
    local aimE = smooth(P.aim)
    sfx("Fire")
    sfx("Echo")
    muzzleFX()
    local k = (1 - 0.4 * aimE) * (S.fireAnim and 0.55 or 1)
    kickRot.v = kickRot.v + Vector3.new(rnd(2.4, 3.2) * k, rnd(-0.5, 0.5) * k, rnd(-0.6, 0.6) * k)
    kickPos.v = kickPos.v + Vector3.new(rnd(-0.1, 0.1), rnd(0.1, 0.3), rnd(2.2, 3.0) * k)
    camKick.v = camKick.v + Vector3.new(rnd(0.5, 0.7) * k, rnd(-0.12, 0.12), rnd(-0.1, 0.1))
    P.fovKick = 3 * k
    if not cam then return end
    local spread = CONFIG.HipSpread + (CONFIG.AimSpread - CONFIG.HipSpread) * aimE
    local cf = cam.CFrame * CFrame.Angles(rnd(-1, 1) * spread, rnd(-1, 1) * spread, 0)
    local origin, dir = cam.CFrame.Position, cf.LookVector
    local res = Workspace:Raycast(origin, dir * CONFIG.Range, rayParams())
    local from = R.muzzle and R.muzzle.WorldPosition or origin
    if res then
        tracer(from, res.Position)
        impact(res.Position, res.Normal, res.Instance)
        local mdl = res.Instance and res.Instance:FindFirstAncestorWhichIsA("Model")
        if mdl and mdl:FindFirstChildOfClass("Humanoid") then hitMarker() end
    else
        tracer(from, origin + dir * 300)
    end
end

local function pullTrigger()
    local now = os.clock()
    if not S.alive or S.closing or S.reloading or now < S.nextShot then return end
    S.nextShot = now + CONFIG.FireInterval
    if S.running then setRun(false) end
    cancelInspect()
    S.cursor = S.cursor + 1
    local slot = slotAt(S.cursor)
    local cur = S.cursor
    task.spawn(function()
        local usePre = A.on and A.ok.PreFire
        tween("hammer", 1, 0.05)
        tween("trigger", 1, 0.05)
        tween("spin", -SLOT_ANGLE * cur, 0.12)
        sfx("PreFire")
        if usePre then A.play("PreFire", 0.03) end
        if not sleep(usePre and CONFIG.PreFireTime or 0.06) then return end
        if slot.state == "live" then
            slot.state = "spent"
            refreshSlots()
            S.fireAnim = false
            if A.on and A.ok.Fire then
                A.stop("PreFire", 0.05)
                A.play("Fire", 0.03)
                S.fireAnim = true
            end
            doShot()
        else
            sfx("Empty")
        end
        refreshAmmoUI()
        tween("hammer", 0, 0.06)
        tween("trigger", 0, 0.12)
    end)
end

local function triggerDown()
