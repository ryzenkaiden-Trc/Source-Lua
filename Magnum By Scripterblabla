local function bindInput()
    track(UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 then
            triggerDown()
        elseif t == Enum.UserInputType.MouseButton2 then
            setAim(true)
        elseif t == Enum.UserInputType.Keyboard then
            local k = input.KeyCode
            if k == Enum.KeyCode.R then reload()
            elseif k == Enum.KeyCode.F then inspect()
            elseif k == Enum.KeyCode.T then magCheck()
            elseif k == Enum.KeyCode.C or k == Enum.KeyCode.LeftControl then setCrouch(not S.crouch)
            elseif k == Enum.KeyCode.LeftShift then setRun(true)
            elseif k == Enum.KeyCode.Q then setLean(-1, true)
            elseif k == Enum.KeyCode.E then setLean(1, true)
            end
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 then
            triggerUp()
        elseif t == Enum.UserInputType.MouseButton2 then
            if S.aimOn then setAim(false) end
        elseif t == Enum.UserInputType.Keyboard then
            local k = input.KeyCode
            if k == Enum.KeyCode.LeftShift then setRun(false)
            elseif k == Enum.KeyCode.Q then setLean(-1, false)
            elseif k == Enum.KeyCode.E then setLean(1, false)
            end
        end
    end))
end

local function armCF(hand, dir)
    dir = dir.Unit
    local center = hand - dir
    return CFrame.lookAt(center, center + dir) * CFrame.Angles(math.pi / 2, 0, 0)
end

local function ringTransform(swing, spin)
    local sw = CFrame.new(HINGE.X, HINGE.Y, 0) * CFrame.Angles(0, 0, SWING_ANGLE * swing) * CFrame.new(-HINGE.X, -HINGE.Y, 0)
    local sp = CFrame.new(R.cyl.X, R.cyl.Y, 0) * CFrame.Angles(0, 0, spin) * CFrame.new(-R.cyl.X, -R.cyl.Y, 0)
    return sw, sw * sp
end

local function poseRig(gcf, camCF, W, arms)
    local parts, J = R.parts, R.J
    local sw, ring = ringTransform(P.swing, P.spin)
    local INS = ring * R.loaderC0
    local READY = INS * CFrame.new(0, 0, 0.55)
    local LP = R.PARK:Lerp(READY, smooth(P.L)):Lerp(INS, smooth(P.Lin))

    parts.Grip.CFrame = gcf
    if A.on and A.full then
        local cj = J.Cylinder
        local cylT = cj.m6 and cj.m6.Transform or ID
        local cylFrame = gcf * cj.c0 * cylT
        local spinAbout = cylFrame * CFrame.fromAxisAngle(R.cylAxis, P.spin) * cylFrame:Inverse()
        local cylDelta = (cj.c0 * cylT * cj.c1i) * (cj.c0 * cj.c1i):Inverse()
        local loading = {}
        for _, s in ipairs(ORDER) do
            if s.state == "loading" then loading[s.bj] = true end
        end
        for _, j in ipairs(R.joints) do
            local T = j.m6 and j.m6.Transform or ID
            local cf
            if j.ring and j ~= cj and not loading[j] and isID(T) then
                cf = gcf * cylDelta * j.c0 * j.c1i
            else
                cf = gcf * j.c0 * T * j.c1i
            end
            if j.ring and not loading[j] then cf = spinAbout * cf end
            j.p1.CFrame = cf
        end
        local rl = A.tracks.Reload
        parts.Loader.Transparency = (rl and rl.IsPlaying) and 0 or 1
    else
        J.Hammer.tr = CFrame.new(0, -0.07, -0.06) * CFrame.Angles(math.rad(-38) * P.hammer, 0, 0) * CFrame.new(0, 0.07, 0.06)
        J.Trigger.tr = CFrame.new(0, 0.08, 0.02) * CFrame.Angles(math.rad(18) * P.trigger, 0, 0) * CFrame.new(0, -0.08, -0.02)
        J.Cylinder.pre = ring
        J.Crane.pre = sw
        J.Extractor.pre = ring
        J.Extractor.tr = CFrame.new(0, 0, 0.3 * P.extractor)
        J.Loader.pre = nil
        J.Loader.tr = R.loaderC0:Inverse() * LP
        for _, s in ipairs(ORDER) do
            if s.state == "loading" then
                s.bj.pre = nil
                s.bj.tr = s.bj.c0:Inverse() * LP * s.relB
            else
                s.bj.pre = ring
                s.bj.tr = ID
            end
            s.cj.pre = ring
            s.cj.tr = ID
        end
        parts.Loader.Transparency = (P.L > 0.01) and 0 or 1
        for _, j in ipairs(R.joints) do
            j.p1.CFrame = gcf * (j.pre or ID) * j.c0 * j.tr * j.c1i
        end
    end

    if P.hand > 0.001 then
        local shoulder = R.HIP:PointToObjectSpace(Vector3.new(-0.9, -1.1, 0.4))
        local hand = LP * Vector3.new(0, -0.1, 0.2)
        local hold = armCF(hand, hand - shoulder)
        parts["Left Arm"].CFrame = gcf * R.LEFT:Lerp(hold, smooth(P.hand))
    elseif arms then
        parts["Left Arm"].CFrame = W * arms.l
    else
        parts["Left Arm"].CFrame = gcf * R.LEFT
    end
    parts["Right Arm"].CFrame = arms and (W * arms.r) or (gcf * R.RIGHT)
    parts.AnimBase.CFrame = camCF
    parts.FakeCamera.CFrame = camCF
end

local function rescanCharacter(char)
    S.charParts = {}
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and not d:FindFirstAncestorWhichIsA("Tool") then
            S.charParts[#S.charParts + 1] = d
        end
    end
end

local function preCamera()
    if not S.alive then return end
    local cam = Workspace.CurrentCamera
    if cam and S.lastOut and S.lastBase and cam.CFrame == S.lastOut then
        cam.CFrame = S.lastBase
    end
end

local function step(dt)
    if not S.alive then return end
    dt = math.min(dt, 0.1)
    local now = os.clock()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then
        S.lastOut = nil
        if R.model.Parent then R.model.Parent = nil end
        OB.setVisible(false)
        return
    end
    OB.setVisible(true)
    if R.model.Parent ~= cam then R.model.Parent = cam end

    for key, tw in pairs(TW) do
        local a = (now - tw.t0) / tw.dur
        if a >= 1 then
            P[key] = tw.to
            TW[key] = nil
        else
            P[key] = tw.from + (tw.to - tw.from) * smooth(a)
        end
    end

    updateShells(dt)

    local vel = root.AssemblyLinearVelocity
    local speed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
    local grounded = hum.FloorMaterial ~= Enum.Material.Air
    local moving = speed > 1.5 and grounded
    local sprinting = S.running and moving and not S.aimOn and not S.reloading and not S.inspecting

    local base = cam.CFrame
    if S.lastOut and base == S.lastOut then base = S.lastBase end

    local aimTarget = (S.aimOn and not S.reloading and not sprinting) and 1 or 0
    P.aim = approach(P.aim, aimTarget, dt / CONFIG.AimTime)
    P.sprint = approach(P.sprint, sprinting and 1 or 0, dt / 0.22)
    P.crouch = approach(P.crouch, S.crouch and 1 or 0, dt / 0.25)
    P.fovKick = (P.fovKick or 0) * math.max(0, 1 - dt * 9)

    local leanTarget = S.leanDir
    if leanTarget ~= 0 then
        local res = Workspace:Raycast(base.Position, base.RightVector * leanTarget * (CONFIG.LeanDistance + 0.35), rayParams())
        if res then
            leanTarget = leanTarget * math.clamp((res.Distance - 0.35) / CONFIG.LeanDistance, 0, 1)
        end
    end
    P.lean = approach(P.lean, leanTarget, dt / 0.18)

    local wallTarget = 0
    if CONFIG.WallPush then
        local res = Workspace:Raycast(base.Position, base.LookVector * 3.2, rayParams())
        if res then wallTarget = math.clamp((3.2 - res.Distance) / 1.3, 0, 1) end
    end
    P.wall = approach(P.wall, wallTarget, dt / 0.15)

    local aimE, spE, wallE, eqE = smooth(P.aim), smooth(P.sprint), smooth(P.wall), smooth(P.equip)
    local crE, leanE = smooth(P.crouch), P.lean

    if crE > 0.001 or S.camOffsetSet then
        hum.CameraOffset = Vector3.new(0, -CONFIG.CrouchDrop * crE, 0)
        S.camOffsetSet = crE > 0.001
    end

    if S.prevBase then
        local d = S.prevBase:ToObjectSpace(base)
        local rx, ry = d:ToEulerAnglesYXZ()
        rx = math.clamp(rx, -0.25, 0.25)
        ry = math.clamp(ry, -0.25, 0.25)
        local g = 0.8 * (1 - 0.75 * aimE)
        sway.p = sway.p + Vector3.new(-rx * g, -ry * g, -ry * g * 0.5)
        local m = sway.p.Magnitude
        if m > 0.14 then sway.p = sway.p * (0.14 / m) end
    end
    S.prevBase = base
    local lv = cam.CFrame:VectorToObjectSpace(vel)
    sway.p = sway.p + Vector3.new(0, 0, -math.clamp(lv.X, -20, 20) * 0.00035 * (1 - aimE))
    stepSpring(sway, dt)
    stepSpring(kickRot, dt)
    stepSpring(kickPos, dt)
    stepSpring(camKick, dt)

    local bobAmp = (moving and math.clamp(speed / 16, 0, 1.6) or 0) * (1 - 0.8 * aimE) * (1 + spE * 0.8)
    S.bobPhase = S.bobPhase + dt * (moving and (4 + speed * 0.42) or 0)
    local ph = S.bobPhase
    local bobPos = Vector3.new(math.sin(ph) * 0.03, math.sin(ph * 2) * 0.02, 0) * bobAmp
        + Vector3.new(0, math.sin(now * 1.3) * 0.004 * (1 - aimE), 0)
    local bobRot = Vector3.new(math.sin(ph * 2) * 0.012, math.sin(ph) * 0.02, math.sin(ph) * 0.012) * bobAmp

    A.update(now)
    local animBody = A.on
    local fcT = nil
    if animBody then
        A.loop("Idle", true)
        A.loop("Sprint", sprinting)
        A.loop("HoldUp", wallE > 0.35 and not sprinting)
        if not A.sawMotion then
            for _, b in pairs(R.body) do
                local T = b.m6.Transform
                if T.Position.Magnitude > 0.002 or (T.LookVector - Vector3.new(0, 0, -1)).Magnitude > 0.002 then
                    A.sawMotion = true
                end
            end
        end
        local fc = R.body.FakeCamera
        if fc and CONFIG.CameraAnimation then
            local d = (fc.c0 * fc.c1i):Inverse() * (fc.c0 * fc.m6.Transform * fc.c1i)
            local rx, ry, rz = d:ToEulerAnglesYXZ()
            local w = CONFIG.CameraAnimWeight * (1 - 0.6 * aimE)
            local lim = math.rad(CONFIG.CameraAnimMaxDeg)
            local target = CFrame.Angles(math.clamp(rx * w, -lim, lim), math.clamp(ry * w, -lim, lim), math.clamp(rz * w, -lim, lim))
            S.fcSm = (S.fcSm or ID):Lerp(target, math.clamp(dt * 20, 0, 1))
            fcT = S.fcSm
        end
    end
    if not fcT then S.fcSm = nil end

    local ck = camKick.p
    local camOut = base
        * CFrame.new(leanE * CONFIG.LeanDistance, -math.abs(leanE) * 0.1, 0)
        * CFrame.Angles(0, 0, -math.rad(CONFIG.LeanAngle) * leanE)
        * CFrame.Angles(ck.X, ck.Y, ck.Z)
        * (fcT or ID)
    cam.CFrame = camOut
    S.lastBase, S.lastOut = base, camOut
    cam.FieldOfView = S.baseFOV + 4 * spE - (S.baseFOV - CONFIG.AimFOV) * aimE + (P.fovKick or 0)

    local gunHip, armL0, armR0
    local pose
    if animBody then
        local B = R.body
        local function bodyPose(b)
            local T = b.m6.Transform
            if isID(T) then return b.c0 * b.hipT * b.c1i end
            return b.c0 * T:Lerp(ID, aimE) * b.c1i
        end
        gunHip = bodyPose(B.Grip)
        armL0 = bodyPose(B["Left Arm"])
        armR0 = bodyPose(B["Right Arm"])
        pose = gunHip:Lerp(R.AIM, aimE)
    else
        pose = R.HIP:Lerp(R.AIM, aimE)
    end
    local lowE = math.max((animBody and A.ok.Sprint) and 0 or spE, (animBody and A.ok.HoldUp) and 0 or wallE)
    if lowE > 0.001 then
        pose = pose * CFrame.new(0.05 * lowE, -0.22 * lowE, 0.12 * lowE)
            * CFrame.Angles(math.rad(-20) * lowE, math.rad(32) * lowE, math.rad(8) * lowE)
    end
    if P.tilt > 0.001 then
        pose = pose * CFrame.new(-0.12 * P.tilt, 0.08 * P.tilt, 0.1 * P.tilt)
            * CFrame.Angles(math.rad(15) * P.tilt, math.rad(8) * P.tilt, math.rad(14) * P.tilt)
    end
    if P.ins > 0.001 or P.ins2 > 0.001 then
        pose = pose * CFrame.new(-0.4 * P.ins, 0.25 * P.ins, 0.3 * P.ins)
            * CFrame.Angles(math.rad(8) * P.ins, math.rad(40) * P.ins, math.rad(-22) * P.ins)
            * CFrame.Angles(0, math.rad(-45) * P.ins2, math.rad(18) * P.ins2)
    end
    if eqE < 0.999 then
        local k = 1 - eqE
        pose = CFrame.new(0.25 * k, -1.2 * k, 0.4 * k) * CFrame.Angles(math.rad(-30) * k, 0, 0) * pose
    end
    local kr, kp = kickRot.p, kickPos.p
    local sp = sway.p
    local Wr = camOut
        * CFrame.Angles(sp.X, sp.Y, sp.Z)
        * CFrame.new(bobPos.X, bobPos.Y, bobPos.Z)
        * CFrame.Angles(bobRot.X, bobRot.Y, bobRot.Z)
        * CFrame.new(kp.X, kp.Y, kp.Z)
        * CFrame.Angles(kr.X, kr.Y, kr.Z)
    local gcf = Wr * pose
    local arms
    if animBody then
        local D = pose * gunHip:Inverse()
        arms = { l = D * armL0, r = D * armR0 }
    end
    poseRig(gcf, camOut, Wr, arms)

    if CONFIG.Automatic and S.trigger and now >= S.nextShot then pullTrigger() end

    if CONFIG.HideCharacter then
        if now - S.lastScan > 1 then
            S.lastScan = now
            rescanCharacter(char)
        end
        for _, p in ipairs(S.charParts) do p.LocalTransparencyModifier = 1 end
    end
    if UI.dot then UI.dot.Visible = aimE < 0.5 and not S.reloading end
end

local Destroy
Destroy = function()
    if not S.alive then return end
    S.alive = false
    pcall(function() RunService:UnbindFromRenderStep("RevolverFPS") end)
    pcall(function() RunService:UnbindFromRenderStep("RevolverFPS_Pre") end)
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    local cam = Workspace.CurrentCamera
    if cam and S.baseFOV then cam.FieldOfView = S.baseFOV end
    pcall(function()
        if S.prevCameraMode then LocalPlayer.CameraMode = S.prevCameraMode end
        local hum = getHum()
        if hum then
            hum.CameraOffset = Vector3.new(0, 0, 0)
            if S.baseSpeed then hum.WalkSpeed = S.baseSpeed end
        end
        for _, p in ipairs(S.charParts) do p.LocalTransparencyModifier = 0 end
    end)
    pcall(function() if UI.gui then UI.gui:Destroy() end end)
    pcall(function() if OB.gui then OB.gui:Destroy() end end)
    pcall(function()
        for _, tr in pairs(A.tracks) do tr:Stop(0) end
    end)
    pcall(function() if R and R.model then R.model:Destroy() end end)
    pcall(function() if fxFolder then fxFolder:Destroy() end end)
    if genv.RevolverFPS and genv.RevolverFPS.Destroy == Destroy then genv.RevolverFPS = nil end
end

local function Close()
    if S.closing or not S.alive then return end
    if A.on and A.ok.Unequip then
        S.closing = true
        S.trigger = false
        A.loop("Sprint", false)
        A.loop("HoldUp", false)
        A.stop("Reload", 0.1); A.stop("Inspect", 0.1); A.stop("MagCheck", 0.1)
        A.play("Unequip", 0.08)
        sfx("AimDown")
        task.delay(math.min(A.length("Unequip"), 1.6), function() Destroy() end)
    else
        Destroy()
    end
end

local function main()
    local missing = {}
    for _, f in ipairs({ CONFIG.FileName, CONFIG.UIFileName, CONFIG.AnimFileName, CONFIG.ReloadAnimFile, CONFIG.InspectAnimFile }) do
        if not ensureFile(f) then missing[#missing + 1] = f end
    end
    if #missing > 0 then
        warn("[RevolverFPS] missing in workspace/" .. tostring(CONFIG.FileDir) .. ": " .. table.concat(missing, ", ")
            .. " -> run your ORIGINAL script once (it writes these files), then run this one.")
    end

    local model, source = loadModel()
    R = buildRig(model)

    local char = LocalPlayer.Character
    local function skin(side)
        if char then
            local p = char:FindFirstChild(side .. " Arm") or char:FindFirstChild(side .. "UpperArm") or char:FindFirstChild(side .. "Hand")
            if p and p:IsA("BasePart") then return p.Color end
        end
        return Color3.fromRGB(245, 205, 175)
    end
    for _, side in ipairs({ "Left", "Right" }) do
        local a = R.parts[side .. " Arm"]
        a.Transparency = 0
        a.Size = Vector3.new(CONFIG.ArmWidth, 2, CONFIG.ArmWidth)
        a.Material = Enum.Material.SmoothPlastic
        a.Color = skin(side)
    end
    R.parts.Grip.Transparency = 1
    R.parts.AimPart.Transparency = 1
    R.parts.AnimBase.Transparency = 1
    R.parts.FakeCamera.Transparency = 1

    fxFolder = Instance.new("Folder")
    fxFolder.Name = "RevolverFPS_FX"
    fxFolder.Parent = Workspace

    refreshSlots()
    S.baseFOV = (Workspace.CurrentCamera and Workspace.CurrentCamera.FieldOfView) or 70
    if CONFIG.LockFirstPerson then
        S.prevCameraMode = LocalPlayer.CameraMode
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
    end

    DEVICE = detectDevice()
    loadAnimations()
    OB.load()
    buildUI()
    bindInput()

    track(LocalPlayer.CharacterAdded:Connect(function(c)
        S.charParts, S.baseSpeed, S.speedApplied, S.camOffsetSet = {}, nil, nil, false
        S.aimOn, S.running, S.crouch, S.leanDir = false, false, false, 0
        refreshButtons()
        task.defer(function() if S.alive then playEquip(false) end end)
    end))

    R.model.Parent = Workspace.CurrentCamera
    RunService:BindToRenderStep("RevolverFPS_Pre", Enum.RenderPriority.Camera.Value - 1, preCamera)
    RunService:BindToRenderStep("RevolverFPS", Enum.RenderPriority.Camera.Value + 1, step)

    genv.RevolverFPS = {
        Destroy = Destroy, Close = Close, Reload = reload, Inspect = inspect, MagCheck = magCheck,
        Shoot = pullTrigger, Config = CONFIG, Source = source,
        Animations = A, OBUI = OB, Device = DEVICE,
    }
    refreshAmmoUI()
    playEquip(true)
end

local ok, err = pcall(main)
if not ok then
    warn("[RevolverFPS] failed: " .. tostring(err))
    pcall(Destroy)
end
