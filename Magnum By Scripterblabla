local function buildRig(model)
    local r = { model = model, parts = {}, J = {}, joints = {}, sounds = {} }
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            r.parts[d.Name] = d
        elseif d:IsA("Sound") then
            r.sounds[d.Name] = d
        end
    end
    local grip = r.parts.Grip
    local gcf = grip.CFrame

    r.HIP   = r.parts.AnimBase.CFrame:ToObjectSpace(gcf)
    r.AIM   = r.parts.AimPart.CFrame:ToObjectSpace(gcf)
    r.LEFT  = gcf:ToObjectSpace(r.parts["Left Arm"].CFrame)
    r.RIGHT = gcf:ToObjectSpace(r.parts["Right Arm"].CFrame)
    r.PARK  = gcf:ToObjectSpace(r.parts.Loader.CFrame)

    local animBase = r.parts.AnimBase
    r.body = {}
    local weldObjs = {}
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("JointInstance") then
            local p0, p1 = d.Part0, d.Part1
            local isM6 = d:IsA("Motor6D")
            if p0 == grip and p1 then
                local rec = { name = d.Name, p1 = p1, c0 = d.C0, c1i = d.C1:Inverse(), tr = ID, pre = nil, m6 = isM6 and d or nil }
                r.joints[#r.joints + 1] = rec
                r.J[p1.Name] = rec
            elseif p0 == animBase and p1 and isM6 then
                r.body[p1.Name] = { name = d.Name, p1 = p1, c0 = d.C0, c1i = d.C1:Inverse(), m6 = d,
                    hipT = d.C0:Inverse() * animBase.CFrame:ToObjectSpace(p1.CFrame) * d.C1 }
            end
            if not isM6 then weldObjs[#weldObjs + 1] = d end
        end
    end
    for _, d in ipairs(weldObjs) do d:Destroy() end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("LuaSourceContainer") then d:Destroy() end
    end
    r.animator = model:FindFirstChildWhichIsA("Animator", true)
    r.canAnimate = (r.body.Grip ~= nil and r.body["Left Arm"] ~= nil and r.body["Right Arm"] ~= nil) and next(r.body) ~= nil
    if r.canAnimate and not r.animator then
        local ac = Instance.new("AnimationController")
        ac.Parent = model
        r.animator = Instance.new("Animator")
        r.animator.Parent = ac
    end
    if r.canAnimate then
        local g = r.body.Grip
        r.restGun = g.c0 * g.c1i
        r.cylAxis = (r.J.Cylinder and r.J.Cylinder.c0 or ID):VectorToObjectSpace(Vector3.new(0, 0, 1))
    end

    for _, p in pairs(r.parts) do
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = false
    end

    r.muzzle = nil
    for _, d in ipairs(grip:GetChildren()) do
        if d:IsA("Attachment") and d.Name == "Muzzle" then r.muzzle = d end
    end
    for _, j in ipairs(r.joints) do
        local n = j.p1.Name
        j.ring = (n == "Cylinder" or n == "Extractor" or n:find("^Bullet") ~= nil or n:find("^Casing") ~= nil)
    end
    r.cyl = r.J.Cylinder.c0.Position
    r.loaderC0 = r.J.Loader.c0
    HINGE = Vector3.new(-0.15, 0.08, 0)

    local slots = {}
    for i = 1, 5 do
        local bj = r.J["Bullet" .. i]
        local c0p = bj.c0.Position
        local best, bestD
        for k = 1, 5 do
            local cj = r.J["Casing" .. k]
            local dx, dy = cj.c0.Position.X - c0p.X, cj.c0.Position.Y - c0p.Y
            local d = math.sqrt(dx * dx + dy * dy)
            if not bestD or d < bestD then best, bestD = k, d end
        end
        slots[i] = {
            bullet = r.parts["Bullet" .. i], bj = bj,
            casing = r.parts["Casing" .. best], cj = r.J["Casing" .. best],
            ang = math.deg(math.atan2(c0p.Y - r.cyl.Y, c0p.X - r.cyl.X)),
            relB = r.loaderC0:Inverse() * bj.c0,
            state = "live",
        }
    end
    local topAng, topD = 90, nil
    for _, s in ipairs(slots) do
        local d = math.abs((s.ang - 90 + 180) % 360 - 180)
        if not topD or d < topD then topD, topAng = d, s.ang end
    end
    for _, s in ipairs(slots) do s.rel = (s.ang - topAng) % 360 end
    table.sort(slots, function(a, b) return a.rel < b.rel end)
    ORDER = slots
    N = #slots
    return r
end

