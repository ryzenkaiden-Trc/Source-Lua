local function updateSpeed()
    if not CONFIG.ControlWalkSpeed then return end
    local hum = getHum()
    if not hum then return end
    if S.speedApplied and math.abs(hum.WalkSpeed - S.speedApplied) > 0.01 then
        S.speedApplied, S.baseSpeed = nil, nil
    end
    if not S.baseSpeed then S.baseSpeed = hum.WalkSpeed end
    local mult = 1
    if S.running then mult = mult * CONFIG.SprintMult end
    if S.crouch then mult = mult * CONFIG.CrouchMult end
    if S.aimOn then mult = mult * CONFIG.AimMult end
    if mult == 1 then
        hum.WalkSpeed = S.baseSpeed
        S.speedApplied, S.baseSpeed = nil, nil
    else
        S.speedApplied = S.baseSpeed * mult
        hum.WalkSpeed = S.speedApplied
    end
end

