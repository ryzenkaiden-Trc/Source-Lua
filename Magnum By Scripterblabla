local function impact(pos, normal, hitPart)
    local s = fxPart(Vector3.new(0.3, 0.3, 0.3))
    s.Shape = Enum.PartType.Ball
    s.Color = Color3.fromRGB(255, 200, 120)
    s.Position = pos + normal * 0.05
