local function loadModel()
    local candidates = {}
    local path, err = ensureFile(CONFIG.FileName)
    if path then candidates[#candidates + 1] = path else dbg("ensureFile:", err) end
    if isfile then
        for _, extra in ipairs(CONFIG.ExtraPaths) do
            local ok, ex = pcall(isfile, extra)
            if ok and ex then candidates[#candidates + 1] = extra end
        end
    end
    for _, p in ipairs(candidates) do
        local m, why = tryLoadFile(p)
        if m then return m, "file " .. p end
        dbg("load failed", p, why)
    end
    return buildFallback(), "fallback (mesh IDs)"
end

