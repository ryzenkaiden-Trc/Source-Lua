local function animPriority(name)
    local function get(n)
        local ok, v = pcall(function() return Enum.AnimationPriority[n] end)
        return (ok and v) or Enum.AnimationPriority.Action
    end
    if name == "Idle" then return get("Idle") end
    if name == "Sprint" or name == "HoldUp" then return get("Movement") end
    if name == "Fire" or name == "PreFire" then return get("Action") end
    return get("Action2")
end

local function sampleJoint(arr, t)
    local n = #arr
    if t <= arr[1].t then return arr[1].cf end
    if t >= arr[n].t then return arr[n].cf end
    local lo, hi = 1, n
    while hi - lo > 1 do
        local mid = math.floor((lo + hi) / 2)
        if arr[mid].t <= t then lo = mid else hi = mid end
    end
    local a, b = arr[lo], arr[hi]
    if a.const then return a.cf end
    return a.cf:Lerp(b.cf, (t - a.t) / (b.t - a.t))
end

local function isID(T)
    return T.Position.Magnitude < 1e-3
        and (T.RightVector - Vector3.xAxis).Magnitude < 1e-3
        and (T.UpVector - Vector3.yAxis).Magnitude < 1e-3
end

local function newKFTrack(ks, motors, rest)
    local joints, length = {}, 0
    for _, kf in ipairs(ks:GetChildren()) do
        if kf:IsA("Keyframe") then
            local kt = kf.Time
            if kt > length then length = kt end
            for _, d in ipairs(kf:GetDescendants()) do
                if d:IsA("Pose") and motors[d.Name] then
                    local arr = joints[d.Name]
                    if not arr then arr = {}; joints[d.Name] = arr end
                    arr[#arr + 1] = { t = kt, cf = d.CFrame, const = (d.EasingStyle == Enum.PoseEasingStyle.Constant) }
                end
            end
        end
    end
    if length <= 0 or next(joints) == nil then return nil end
    for _, arr in pairs(joints) do
        table.sort(arr, function(x, y) return x.t < y.t end)
    end
    local last = {}
    local tr = { Length = length, IsPlaying = false, Looped = false }
    local function release()
        for name, lt in pairs(last) do
            local m = motors[name]
            if m and m.Transform == lt then m.Transform = ID end
        end
        table.clear(last)
    end
    function tr:Play(fade, _, speed)
        self.t0 = os.clock()
        self.speed = speed or 1
        self.fadeIn = math.max(fade or 0.1, 0.001)
        self.stopT = nil
        self.IsPlaying = true
    end
    function tr:Stop(fade)
        if not self.IsPlaying or self.stopT then return end
        fade = fade or 0.1
        if fade <= 0 then
            self.IsPlaying = false
            release()
            return
        end
        self.stopT = os.clock()
        self.fadeOut = fade
    end
    function tr:step(now)
        local el = (now - self.t0) * self.speed
        if el >= self.Length then
            if self.Looped then
                el = el % self.Length
                self.t0 = now - el / self.speed
            else
                self.IsPlaying = false
                release()
                return
            end
        end
        local w = math.min(1, (now - self.t0) / self.fadeIn)
        if self.stopT then
            w = w * (1 - (now - self.stopT) / self.fadeOut)
            if w <= 0 then
                self.IsPlaying = false
                release()
                return
            end
        end
        for name, arr in pairs(joints) do
            local m = motors[name]
            local cf = sampleJoint(arr, el)
            local cur = m.Transform
            local base = cur
            if (last[name] ~= nil and cur == last[name]) or (rest[name] and isID(cur)) then
                base = rest[name] or ID
            end
            m.Transform = (w >= 0.999) and cf or base:Lerp(cf, w)
            last[name] = m.Transform
        end
    end
    return tr
end

local function loadAnimations()
    if not (CONFIG.UseAnimations and R.canAnimate and R.animator) then return end
    local src, from = {}, "ids"
    local path = ensureFile(CONFIG.AnimFileName)
    if path then
        local objs = loadObjects(path)
        if objs then
            for _, o in ipairs(objs) do
                local list = o:GetDescendants()
                list[#list + 1] = o
                for _, d in ipairs(list) do
                    if d:IsA("Animation") and d.AnimationId ~= "" then
                        local key = d.Name:match("_(.+)$") or d.Name
                        src[key] = d
                        from = "file " .. path
                    end
                end
            end
        end
    end
    local kfSrc, skip = {}, {}
    for _, def in ipairs({
        { "Reload",  CONFIG.ReloadAnimFile },
        { "Inspect", CONFIG.InspectAnimFile },
    }) do
        local key = def[1]
        local p = ensureFile(def[2])
        local objs = p and loadObjects(p)
        local ks
        for _, o in ipairs(objs or {}) do
            if not ks then
                ks = o:IsA("KeyframeSequence") and o or o:FindFirstChildWhichIsA("KeyframeSequence", true)
            end
        end
        if ks then
            kfSrc[key] = ks
            local okR, id = pcall(function() return KSP:RegisterKeyframeSequence(ks) end)
            if okR and type(id) == "string" and id ~= "" then
                local a = Instance.new("Animation")
                a.Name = "Brocklin_" .. key
                a.AnimationId = id
                src[key] = a
                A.custom[key] = "engine"
            else
                src[key] = nil
                skip[key] = true
            end
        end
    end
    for name, id in pairs(ANIM_IDS) do
        if not src[name] and not skip[name] then
            local a = Instance.new("Animation")
            a.Name = "Brocklin_" .. name
            a.AnimationId = id
            src[name] = a
        end
    end
    for name, anim in pairs(src) do
        local ok, tr = pcall(function() return R.animator:LoadAnimation(anim) end)
        if ok and tr then
            pcall(function() tr.Priority = animPriority(name) end)
            A.tracks[name] = tr
        end
    end
    local t0 = os.clock()
    while os.clock() - t0 < CONFIG.AnimLoadTime do
        local pending = false
        for _, tr in pairs(A.tracks) do
            if tr.Length <= 0 then pending = true end
        end
        if not pending then break end
        task.wait(0.1)
    end
    local motors, rest
    for key, ks in pairs(kfSrc) do
        local tr = A.tracks[key]
        if not tr or tr.Length <= 0 then
            if not motors then
                motors = {}
                rest = {}
                for name, b in pairs(R.body) do rest[name] = b.hipT end
                for name, b in pairs(R.body) do if b.m6 then motors[name] = b.m6 end end
                for name, j in pairs(R.J) do if j.m6 then motors[name] = j.m6 end end
            end
            if tr then pcall(function() tr:Stop(0) end) end
            local okK, kt = pcall(newKFTrack, ks, motors, rest)
            if okK and kt then
                A.tracks[key] = kt
                A.kf[key] = true
                A.custom[key] = "player"
            else
                warn("[RevolverFPS] new " .. key .. " animation could not be loaded")
            end
        end
    end
    local n = 0
    for name, tr in pairs(A.tracks) do
        if tr.Length > 0 then A.ok[name] = true; n = n + 1 end
        dbg("animation", name, tr.Length > 0 and string.format("%.2fs", tr.Length) or "NOT LOADED")
    end
    A.on = n > 0
    A.source = from
    A.count = n
end

function A.fail(why)
    if not A.on then return end
    A.on, A.full = false, false
    for _, tr in pairs(A.tracks) do pcall(function() tr:Stop(0) end) end
    dbg("animations disabled:", why)
end

function A.play(name, fade, speed)
    if not (A.on and A.ok[name]) then return nil end
    local tr = A.tracks[name]
    pcall(function()
        tr.Looped = false
        tr:Play(fade or 0.1, 1, speed or 1)
    end)
    if not A.checkT and tr.Length >= 0.4 and name ~= "Idle" then A.checkT = os.clock() + 0.6 end
    return tr
end

function A.stop(name, fade)
    local tr = A.tracks[name]
    if tr then pcall(function() tr:Stop(fade or 0.15) end) end
end

function A.loop(name, on)
    if not (A.on and A.ok[name]) then return end
    if A.loops[name] == on then return end
    A.loops[name] = on
    local tr = A.tracks[name]
    pcall(function()
        if on then
            tr.Looped = true
            tr:Play(0.25)
        else
            tr:Stop(0.25)
        end
    end)
end

function A.length(name, speed)
    local tr = A.tracks[name]
    return tr and (tr.Length / (speed or 1)) or 0
end

function A.update(now)
    if A.on then
        for name in pairs(A.kf) do
            local tr = A.tracks[name]
            if tr and tr.IsPlaying then tr:step(now) end
        end
    end
    if not A.on then A.full = false return end
    local f = false
    for name in pairs(FULL) do
        local tr = A.tracks[name]
        if tr and tr.IsPlaying then f = true break end
    end
    A.full = f
    if A.checkT and not A.verified and now >= A.checkT then
        if A.sawMotion then A.verified = true else A.fail("rig did not move") end
    end
end

