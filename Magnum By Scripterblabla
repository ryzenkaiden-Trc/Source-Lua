function OB.refresh()
    if not OB.on then return end
    local live = countLive()
    local inf = CONFIG.InfiniteReserve
    local mags, rem = spareMags()
    if OB.name then OB.name.Text = "Brocklin R5" end
    if OB.cal then OB.cal.Text = ".500 Magnum" end
    if OB.total then OB.total.Text = inf and "+" or tostring(mags) end

    local key = inf and "inf" or (mags .. ":" .. rem)
    if key ~= OB.key then
        OB.key = key
        for _, c in ipairs(OB.mags:GetChildren()) do
            if c.Name == "MagazineClone" then c:Destroy() end
        end
        if OB.template and not inf then
            local n = math.min(3, mags + (rem > 0 and 1 or 0))
            for i = 1, n do
                local c = OB.template:Clone()
                c.Name = "MagazineClone"
                c.Visible = true
                c.Parent = OB.mags
                local f = (i ~= n or rem <= 0) and 1 or rem / N
                if mags == 0 and rem > 0 then f = rem / N end
                local fill = c:FindFirstChild("Fill")
                if fill then
                    fill.Size = UDim2.new(1, 0, f, 0)
                    fill.Position = UDim2.new(0, 0, 1 - f, 0)
                end
            end
        end
        if OB.plus then OB.plus.Visible = (not inf) and mags > 3 end
    end

    if OB.cur then
        local total = live + (inf and 1 or S.reserve)
        OB.cur.Visible = total > 0
        if OB.curPlus then OB.curPlus.Visible = false end
        if OB.curFill and OB.fillKey ~= live then
            local first = OB.fillKey == nil
            OB.fillKey = live
            local f = math.clamp(live / N, 0, 1)
            local col = f > 0.6 and WHITE or (f > 0.3 and Color3.fromRGB(255, 200, 140) or Color3.fromRGB(255, 80, 80))
            local goal = { Size = UDim2.new(1, 0, f, 0), Position = UDim2.new(0, 0, 1 - f, 0), BackgroundColor3 = col }
            if first then
                for k, v in pairs(goal) do OB.curFill[k] = v end
            else
                TweenService:Create(OB.curFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
            end
        end
    end
    if OB.magCheck and OB.magCheck.Visible then OB.showMagCheck() end
end

