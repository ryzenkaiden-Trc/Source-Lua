local function mountGui(gui)
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
    local targets = {}
    if gethui then targets[#targets + 1] = function() return gethui() end end
    targets[#targets + 1] = function() return game:GetService("CoreGui") end
    targets[#targets + 1] = function() return LocalPlayer:WaitForChild("PlayerGui") end
    for _, get in ipairs(targets) do
        local okT, parent = pcall(get)
        if okT and parent then
            local okP = pcall(function() gui.Parent = parent end)
            if okP and gui.Parent == parent then return true end
        end
    end
    return false
end

function OB.load()
    if not CONFIG.UseOBUI then return false end
    local path, err = ensureFile(CONFIG.UIFileName)
    if not path then dbg("OB_UI file:", err) return false end
    local objs, why = loadObjects(path)
    if not objs then dbg("OB_UI load:", why) return false end
    local gui
    for _, o in ipairs(objs) do
        if not gui and o:IsA("ScreenGui") then gui = o else pcall(function() o:Destroy() end) end
    end
    if not gui then return false end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("LuaSourceContainer") then pcall(function() d:Destroy() end) end
    end
    for _, n in ipairs({ "DamageUI", "TunnelVision", "AimVignette", "PickUpUI", "Ammo", "FiremodeCheck" }) do
        local x = gui:FindFirstChild(n)
        if x then x:Destroy() end
    end
    local ver = gui:FindFirstChild("Version")
    if ver then ver.Visible = CONFIG.ShowVersion end
    local mag = gui:FindFirstChild("MagUI")
    local mags = mag and mag:FindFirstChild("Magazines")
    if not (mag and mags) then pcall(function() gui:Destroy() end) return false end

    OB.gui, OB.mag, OB.mags = gui, mag, mags
    OB.name, OB.cal, OB.total = mag:FindFirstChild("WeaponName"), mag:FindFirstChild("Caliber"), mag:FindFirstChild("TotalMagCount")
    OB.fire = mag:FindFirstChild("Firemodes")
    OB.template, OB.plus = mags:FindFirstChild("Magazine"), mags:FindFirstChild("Plus")
    OB.cur = mags:FindFirstChild("CurrentMagazine")
    OB.curFill = OB.cur and OB.cur:FindFirstChild("Fill")
    OB.curPlus = OB.cur and OB.cur:FindFirstChild("MagPlus")
    local mc = gui:FindFirstChild("MagCheck")
    if mc then
        OB.magCheck = mc
        OB.magLeft, OB.ammoLeft = mc:FindFirstChild("MagLeftText"), mc:FindFirstChild("AmmoLeftText")
        local m = mc:FindFirstChild("Mag")
        OB.filling = m and m:FindFirstChild("Filling")
        local lay = m and m:FindFirstChildOfClass("UIListLayout")
        if lay then pcall(function() lay.VerticalAlignment = Enum.VerticalAlignment.Bottom end) end
        local pa = mc:FindFirstChild("PlusAmmo")
        if pa then pa.Visible = false end
        local wb = mc:FindFirstChild("WhiteBackground")
        if wb then wb.Visible = false end
        mc.Visible = false
    end
    pcall(function() gui.ResetOnSpawn = false end)
    pcall(function() gui:SetAttribute("RevolverFPS", true) end)

    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
    if pg then
        for _, c in ipairs(pg:GetChildren()) do
            local okA, mine = pcall(function() return c:GetAttribute("RevolverFPS") end)
            if okA and mine and c ~= gui then pcall(function() c:Destroy() end) end
        end
    end
    local parented = false
    if pg then
        local okP = pcall(function() gui.Parent = pg end)
        parented = okP and gui.Parent == pg
    end
    if not parented and not mountGui(gui) then
        pcall(function() gui:Destroy() end)
        OB.gui = nil
        return false
    end
    OB.on = true
    OB.setFiremode(CONFIG.Automatic and "Auto" or "Semi")
    OB.refresh()
    return true
end

