local function reloadAnimated(ok)
    local m = CONFIG.ReloadMarks
    A.stop("Fire", 0.05)
    A.stop("PreFire", 0.05)
    A.play("Reload", 0.12)
    local len = A.length("Reload")
    local t0 = os.clock()
    local function at(sec) return sleep(math.max(0, t0 + math.min(sec, len) - os.clock()), ok) end
    local returned, total, newLive = 0, 0, 0
    sfx("Move1")
    local done = at(m.BoltOpen)
    if done then sfx("BoltOpen") end
    done = done and at(m.Hand)
    if done then sfx("Hand") end
    done = done and at(m.Casing)
    if done then
        returned = countLive()
        ejectShells()
        refreshAmmoUI()
        total = returned + S.reserve
        newLive = math.min(N, total)
        if CONFIG.InfiniteReserve then newLive = N end
    end
    done = done and at(m.MagOut)
    if done then sfx("MagOut") end
    done = done and at(m.MagPouch)
    if done then
        for k = 1, newLive do slotAt(S.cursor + k).state = "loading" end
        refreshSlots()
        sfx("MagPouch")
    end
    done = done and at(m.MagIn)
    if done then sfx("MagIn") end
    done = done and at(m.Move2)
    if done then
        for k = 1, newLive do slotAt(S.cursor + k).state = "live" end
        if not CONFIG.InfiniteReserve then S.reserve = total - newLive end
        refreshSlots()
        refreshAmmoUI()
        sfx("Move2")
    end
    done = done and at(m.BoltClose)
    if done then sfx("BoltClose") end
    done = done and at(len)
    if ok() then
        S.reloading = false
        S.token = nil
        refreshButtons()
    end
end

local function reload()
    if S.reloading or not S.alive then return end
    local live = countLive()
    if live >= N then return end
    if S.reserve <= 0 and not CONFIG.InfiniteReserve then sfx("Empty") return end
    cancelInspect()
    S.reloading = true
    S.aimOn = false
    if S.running then S.running = false end
    updateSpeed()
    refreshButtons()
    local token = {}
    S.token = token
    local function ok() return alive(token) end
    if A.on and A.ok.Reload then
        task.spawn(function() reloadAnimated(ok) end)
        return
    end
    task.spawn(function()
        tween("tilt", 1, 0.35)
        sfx("Raise")
        if not sleep(0.35, ok) then return end
        tween("swing", 1, 0.28)
        sfx("BoltOpen")
